@if(IsVisible){
    <div class="modal-backdrop fade show"> </div>
    <div class="modal fade show" tabindex="-1" style="display: block;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

    <div class="card p-4 shadow">
        <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3">
                
                <div class="col-md-6">
                    <label class="form-label">Tên Cửa hàng</label>
                    <InputText @bind-Value="Model.StoreName" class="form-control" />
                    <ValidationMessage For="@(() => Model.StoreName)" class="text-danger" />
                </div>
                
                <div class="col-md-6">
                    <label class="form-label" for="phone">Số điện thoại</label>
                    <InputText id="phone" @bind-Value="Model.Phone" class="form-control" />
                    <ValidationMessage For="@(() => Model.Phone)" class="text-danger" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="logoUrl">Logo URL</label>
                    <InputText id="logoUrl" @bind-Value="Model.Description" class="form-control" placeholder="Dán link ảnh logo cửa hàng" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="address">Địa chỉ</label>
                    <InputText id="address" @bind-Value="Model.Address" class="form-control" />
                    <ValidationMessage For="@(() => Model.Address)" class="text-danger" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="description">Mô tả ngắn</label>
                    <InputTextArea id="description" @bind-Value="Model.Description" class="form-control" rows="3" />
                </div>
                
                <div class="col-12 mt-4">
                    <div class="form-check">
                        <InputCheckbox id="isActive" @bind-Value="Model.IsActive" class="form-check-input" />
                        <label class="form-check-label" for="isActive">Kích hoạt Cửa hàng</label>
                    </div>
                </div>

                <div class="col-12 pt-3">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bx bx-save"></i> Lưu
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>
</div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDataSaved { get; set; }
    private StoreDto Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0) new StoreDto();
    }

    private async Task LoadStoreData(int id)
    {
        var store = await StoreService.GetItemByIdAsync(id);
        if (store != null)
        {
            Model = store;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi khi tải dữ liệu .");
            await OnClose.InvokeAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && (Id != 0 && Model?.Id != Id))
        {
            await LoadStoreData(Id);
        }
        else if (IsVisible && Id == 0)
        {
            Model = new StoreDto { };
        }
    }

    private async Task HandleSubmit()
    {
        bool result = Id == 0
            ? await StoreService.CreateItemAsync(Model)
            : await StoreService.UpdateItemAsync(Model);

        if (result) await OnDataSaved.InvokeAsync();
    }

    private async Task CLoseModal()
    {
        await OnClose.InvokeAsync();
    }
}
