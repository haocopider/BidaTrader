@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show" tabindex="-1" style="display:block;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">

                <!-- HEADER -->
                <div class="modal-header">
                    <h4 class="modal-title fw-bold">
                        <span class="text-muted fw-light">Tài khoản</span>
                    </h4>
                    <button type="button" class="btn-close" @onclick="CLoseModal"></button>
                </div>

                <!-- SEARCH BAR (TOP) -->
                <div class="border-bottom p-3 bg-light">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="bx bx-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Nhập UID (GUID) để tải dữ liệu tài khoản..."
                               @bind="SearchUID" />

                        <button class="btn btn-primary"
                                @onclick="SearchAccountByUID"
                                disabled="@string.IsNullOrWhiteSpace(SearchUID)">
                            Tìm kiếm
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SearchError))
                    {
                        <div class="text-danger small mt-2">@SearchError</div>
                    }
                </div>

                <!-- BODY -->
                <div class="modal-body">

                    @if (IsLoading)
                    {
                        <div class="d-flex justify-content-center py-5">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="row g-4">

                                <!-- LEFT: AVATAR -->
                                <div class="col-md-4 text-center border-end">

                                    <img src="@(string.IsNullOrWhiteSpace(ImagePreviewUrl)
                                                                                 ? (string.IsNullOrWhiteSpace(Model.AvatarUrl)
                                                                                     ? "img/default-avatar.png"
                                                                                     : Model.AvatarUrl)
                                                                                 : ImagePreviewUrl)"
                                         class="rounded-circle shadow-sm border mb-3"
                                         style="width:160px;height:160px;object-fit:cover;"
                                         alt="Avatar" />

                                    <label class="form-label small">Ảnh đại diện</label>
                                    <InputFile OnChange="HandleFileSelection"
                                               class="form-control"
                                               accept="image/*" />

                                </div>

                                <!-- RIGHT: FORM -->
                                <div class="col-md-8">

                                    <div class="row g-3">

                                        <div class="col-md-6">
                                            <label class="form-label">Tên đăng nhập</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bx bx-user"></i></span>
                                                <InputText class="form-control"
                                                           @bind-Value="Model.UserName"
                                                           disabled />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Mật khẩu</label>
                                            <InputText type="password"
                                                       class="form-control"
                                                       @bind-Value="Model.PasswordHash"
                                                       placeholder="Chỉ nhập khi tạo mới" />
                                            <ValidationMessage For="@(() => Model.PasswordHash)" />
                                        </div>

                                    </div>

                                </div>
                            </div>

                            <!-- FOOTER -->
                            <div class="mt-4 text-end border-top pt-3">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="bx bx-save me-1"></i> Lưu
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="CLoseModal">
                                    Hủy
                                </button>
                            </div>

                        </EditForm>
                    }

                </div>
            </div>
        </div>
    </div>
}

@code {

    public AccountDto? Model { get; set; } = new ();

    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDataSaved { get; set; }
    private bool IsLoading { get; set; } = false;
    private string SearchUID { get; set; } = string.Empty;
    private string SearchError { get; set; } = string.Empty;

    private string? ImagePreviewUrl { get; set; }
    private IBrowserFile? selectedFile;
    private const int MAX_FILE_SIZE = 5 * 1024 * 1024;

    protected override void OnInitialized()
    {
        if (Id == 0) Model = new AccountDto();
    }

    private async Task LoadAccountData(int id)
    {
        IsLoading = true;
        var result = await AccountService.GetItemByIdAsync(id);
        if(result != null)
        {
            Model = result;
            SearchUID = Model.UID;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi khi tải dữ liệu tài khoản.");
            await OnClose.InvokeAsync();
        }
        IsLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && (Id != 0 && Model?.Id != Id))
        {
            await LoadAccountData(Id);
        }
        else if (IsVisible && Id == 0)
        {
            Model = new AccountDto { };
        }
    }

    private async Task SearchAccountByUID()
    {
        if (string.IsNullOrWhiteSpace(SearchUID)) return;

        SearchError = "";
        IsLoading = true;

        try
        {
            var result = await Http.GetFromJsonAsync<AccountDto>($"api/accounts/uid/{SearchUID}");

            if (result != null && result.Id != 0)
            {
                Model = result;
            }
            else
            {
                SearchError = "Không tìm thấy tài khoản nào khớp với UID này.";
            }
        }
        catch (Exception)
        {
            SearchError = "Lỗi kết nối API hoặc UID không hợp lệ.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        bool result = Id == 0
            ? await AccountService.CreateItemAsync(Model)
            : await AccountService.UpdateItemAsync(Model);

        if (result) await OnDataSaved.InvokeAsync();
    }

    private async Task CLoseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        // 1. Lấy file đầu tiên được chọn
        selectedFile = e.File;

        if (selectedFile != null)
        {
            if (selectedFile.Size > MAX_FILE_SIZE)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Kích thước file quá lớn (tối đa 5MB).");
                return;
            }

            // 2. Tạo Data URL để hiển thị ảnh
            // Blazor cung cấp phương thức RequestImageFileAsync để tối ưu hóa việc tạo thumbnail
            var imageFile = await selectedFile.RequestImageFileAsync(
                selectedFile.ContentType,
                100,
                100);

            using var fileStream = imageFile.OpenReadStream(MAX_FILE_SIZE);

            using var memoryStream = new MemoryStream();
            await fileStream.CopyToAsync(memoryStream);

            var imageBase64 = Convert.ToBase64String(memoryStream.ToArray());

            ImagePreviewUrl = $"data:{imageFile.ContentType};base64,{imageBase64}";

            // 3. (TÙY CHỌN): Nếu bạn muốn Model.AvatarUrl lưu Data URL (Không nên nếu bạn upload)
            // Model.AvatarUrl = ImagePreviewUrl;
        }
    }
}