@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show" tabindex="-1" style="display:block;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow">

                <!-- HEADER -->
                <div class="modal-header">
                    <h4 class="modal-title fw-bold">
                        <span class="text-muted fw-light">Tài khoản</span>
                    </h4>
                    <button type="button" class="btn-close" @onclick="CLoseModal"></button>
                </div>

                <!-- SEARCH BAR (TOP) -->
                <div class="border-bottom p-3 bg-light">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white">
                            <i class="bx bx-search"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Nhập UID (GUID) để tải dữ liệu tài khoản..."
                               @bind="SearchUID" />

                        <button class="btn btn-primary"
                                @onclick="SearchAccountByUID"
                                disabled="@string.IsNullOrWhiteSpace(SearchUID)">
                            Tìm kiếm
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SearchError))
                    {
                        <div class="text-danger small mt-2">@SearchError</div>
                    }
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    @if (IsLoading)
                    {
                        <div class="d-flex justify-content-center py-5">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bx bx-user"></i></span>
                                        <InputText class="form-control" @bind-Value="Model.UserName" disabled="@(Id != 0)" />
                                    </div>
                                    <ValidationMessage For="@(() => Model.UserName)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Mật khẩu</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bx bx-lock"></i></span>
                                        <InputText type="password"
                                                   class="form-control"
                                                   @bind-Value="Model.PasswordHash"
                                                   placeholder="@(Id != 0 ? "Để trống nếu không đổi" : "Nhập mật khẩu...")" />
                                    </div>
                                    <ValidationMessage For="@(() => Model.PasswordHash)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                                        <InputText class="form-control" @bind-Value="Model.Email" placeholder="example@mail.com" />
                                    </div>
                                    <ValidationMessage For="@(() => Model.Email)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bx bx-phone"></i></span>
                                        <InputText class="form-control" @bind-Value="Model.Phone" placeholder="09xxxxxxxx" />
                                    </div>
                                    <ValidationMessage For="@(() => Model.Phone)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">PassCode</label>
                                    <InputText class="form-control" @bind-Value="Model.Passcode" placeholder="Mã bảo mật phụ (nếu có)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">UID (Hệ thống)</label>
                                    <InputText class="form-control bg-light" @bind-Value="Model.UID" readonly />
                                </div>

                                <div class="col-12 mt-3">
                                    <div class="form-check form-switch p-3 border rounded bg-light d-flex align-items-center">
                                        <InputCheckbox class="form-check-input m-0 me-3"
                                                       style="width: 2.5em; height: 1.5em;"
                                                       @bind-Value="Model.IsActive"
                                                       id="isActiveSwitch" />
                                        <div>
                                            <label class="form-check-label fw-bold text-dark" for="isActiveSwitch">
                                                Kích hoạt tài khoản
                                            </label>
                                            <div class="text-muted small">
                                                @(Model.IsActive ? "Người dùng có thể đăng nhập." : "Tài khoản đang bị khóa.")
                                            </div>
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => Model.IsActive)" />
                                </div>
                            </div>

                            <div class="mt-4 text-end border-top pt-3">
                                <button type="submit" class="btn btn-primary me-2 px-4">
                                    <i class="bx bx-save me-1"></i> Lưu thay đổi
                                </button>
                                <button type="button" class="btn btn-outline-secondary px-4" @onclick="CLoseModal">
                                    Hủy bỏ
                                </button>
                            </div>

                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {

    public AccountDto? Model { get; set; } = new ();

    [Parameter] public int Id { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDataSaved { get; set; }
    private bool IsLoading { get; set; } = false;
    private string SearchUID { get; set; } = string.Empty;
    private string SearchError { get; set; } = string.Empty;

    private string? ImagePreviewUrl { get; set; }
    private IBrowserFile? selectedFile;
    private const int MAX_FILE_SIZE = 5 * 1024 * 1024;

    protected override void OnInitialized()
    {
        if (Id == 0) Model = new AccountDto();
    }

    private async Task LoadAccountData(int id)
    {
        IsLoading = true;
        var result = await AccountService.GetItemByIdAsync(id);
        if(result != null)
        {
            Model = result;
            SearchUID = Model.UID;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi khi tải dữ liệu tài khoản.");
            await OnClose.InvokeAsync();
        }
        IsLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && (Id != 0 && Model?.Id != Id))
        {
            await LoadAccountData(Id);
        }
        else if (IsVisible && Id == 0)
        {
            Model = new AccountDto { };
        }
    }

    private async Task SearchAccountByUID()
    {
        if (string.IsNullOrWhiteSpace(SearchUID)) return;

        SearchError = "";
        IsLoading = true;

        try
        {
            var result = await Http.GetFromJsonAsync<AccountDto>($"api/accounts/uid/{SearchUID}");

            if (result != null && result.Id != 0)
            {
                Model = result;
            }
            else
            {
                SearchError = "Không tìm thấy tài khoản nào khớp với UID này.";
            }
        }
        catch (Exception)
        {
            SearchError = "Lỗi kết nối API hoặc UID không hợp lệ.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        bool result = Id == 0
            ? await AccountService.CreateItemAsync(Model)
            : await AccountService.UpdateItemAsync(Model);

        if (result) await OnDataSaved.InvokeAsync();
    }

    private async Task CLoseModal()
    {
        await OnClose.InvokeAsync();
    }

}