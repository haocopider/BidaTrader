<EditForm Model="Product" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="row g-4">

        <!-- LEFT: PRODUCT INFO -->
        <div class="col-lg-8">

            <div class="mb-4">
                <label class="form-label small text-muted">Tên sản phẩm</label>
                <InputText @bind-Value="Product.Name"
                           class="form-control form-control-lg"
                           placeholder="Ví dụ: Gậy bida Adam AX-1" />
                <ValidationMessage For="@(() => Product.Name)" />
            </div>

            <div class="mb-4">
                <label class="form-label small text-muted">Mô tả</label>
                <InputTextArea @bind-Value="Product.Description"
                               class="form-control"
                               rows="4"
                               placeholder="Mô tả ngắn gọn về sản phẩm..." />
                <ValidationMessage For="@(() => Product.Description)" />
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Giá bán (VNĐ)</label>
                    <InputNumber @bind-Value="Product.Price"
                                 class="form-control"
                                 placeholder="0" />
                    <ValidationMessage For="@(() => Product.Price)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-muted">Danh mục</label>
                    <InputSelect @bind-Value="Product.CategoryId"
                                 class="form-select">
                                 <option value="0" >--Vui lòng chọn danh mục--</option>
                        @foreach (var cat in Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Product.CategoryId)" />
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Số lượng tồn kho</label>
                    <InputNumber @bind-Value="Product.Quantity"
                                 class="form-control"
                                 placeholder="0" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-muted">Thương hiệu</label>
                    <InputSelect @bind-Value="Product.BrandId"
                    class="form-select">
                        @foreach(var bra in Brands)
                        {
                            <option value="@bra.Id">@bra.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Product.BrandId)" />
                </div>
            </div>

        </div>

        <!-- RIGHT: IMAGE UPLOAD -->
        <div class="col-lg-4">
            <div class="border rounded p-3 bg-light h-100">
                <label class="form-label small text-muted mb-2">Hình ảnh sản phẩm</label>

                <div class="d-flex flex-wrap gap-2">

                    @* 1. HIỂN THỊ ẢNH ĐÃ LƯU (ẢNH CŨ TỪ SERVER) *@
                    @if (Product.Images != null)
                    {
                        @foreach (var url in Product.Images)
                        {
                            var imgP = url.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? url
                            : $"https://localhost:7049{url}";
                            <div class="position-relative border rounded overflow-hidden"
                                 style="width: 96px; height: 96px;">
                                <img src="@imgP" class="w-100 h-100 object-fit-cover" />
                                @* Nút xóa ảnh cũ *@
                                <button type="button"
                                        class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle"
                                        style="padding: 0px 5px;"
                                        @onclick="() => RemoveOldImage(url)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    }

                    @* 2. HIỂN THỊ ẢNH MỚI CHỌN (BASE64) *@
                    @foreach (var img in NewImages)
                    {
                        <div class="position-relative border rounded overflow-hidden border-primary"
                             style="width: 96px; height: 96px;">
                            <img src="@img.Base64Data"
                                 class="w-100 h-100 object-fit-cover" />
                            <button type="button"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle"
                                    style="padding: 0px 5px;"
                                    @onclick="() => RemoveNewImage(img)">
                                <i class="bi bi-x"></i>
                            </button>
                            <span class="badge bg-primary position-absolute bottom-0 start-0 m-1 small" style="font-size: 0.6rem;">Mới</span>
                        </div>
                    }

                    @* 3. NÚT THÊM ẢNH *@
                    <label class="d-flex align-items-center justify-content-center border border-dashed rounded bg-white text-primary shadow-sm"
                           style="width: 96px; height: 96px; cursor: pointer;">
                        <InputFile OnChange="OnInputFileChange"
                                   multiple hidden
                                   accept=".jpg,.png,.jpeg,.webp" />
                        <i class="bi bi-plus-lg fs-4"></i>
                    </label>

                </div>

                @if (!string.IsNullOrEmpty(UploadError))
                {
                    <div class="text-danger small mt-2">@UploadError</div>
                }
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="OnClose">
            Huỷ
        </button>
        <button type="submit"
                class="btn btn-primary px-4">
            Lưu sản phẩm
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public ProductCreateUpdateDto Product { get; set; } = new();
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<BrandDto> Brands { get; set; } = new();
    [Parameter] public EventCallback<ProductCreateUpdateDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<ImagePreviewDto> NewImages = new();
    private string UploadError = "";
    private const long MaxFileSize = 1024 * 1024 * 5; // 5MB

    protected override void OnParametersSet()
    {
        NewImages.Clear();
        UploadError = "";
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        UploadError = "";
        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                var buffer = new byte[file.Size];
                await file.OpenReadStream(MaxFileSize).ReadAsync(buffer);
                var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
                NewImages.Add(new ImagePreviewDto { Base64Data = base64 });
            }
        }
        catch (Exception ex) { UploadError = ex.Message; }
    }

    private void RemoveOldImage(string url)
    {
        Product.Images?.Remove(url);
    }

    private void RemoveNewImage(ImagePreviewDto img) => NewImages.Remove(img);

    private async Task HandleSubmit()
    {
        if (Product.CategoryId == 0)
        {
            UploadError = "Vui lòng chọn danh mục!";
            return;
        }

        // Đảm bảo danh sách không null
        if (Product.Images == null) Product.Images = new List<string>();

        // Lấy tất cả ảnh mới (Base64) gộp vào danh sách Images hiện tại
        // Lưu ý: List Product.Images lúc này đã chứa các URL cũ (những cái chưa bị RemoveOldImage xóa)
        var allImages = new List<string>();

        // Giữ lại các URL cũ
        allImages.AddRange(Product.Images.Where(x => x.StartsWith("/") || x.StartsWith("http")));

        // Thêm các Base64 mới
        allImages.AddRange(NewImages.Select(x => x.Base64Data));

        Product.Images = allImages;

        await OnValidSubmit.InvokeAsync(Product);
    }
    public class ImagePreviewDto { public string Base64Data { get; set; } }
}