@page "/register-store"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Đăng ký bán hàng</PageTitle>

        <div class="flex-grow-1 container-p-y">
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav nav-pills flex-column flex-md-row mb-3">
                        <li class="nav-item">
                            <a class="nav-link active" href="/profile"><i class="bx bx-user me-1"></i> Tài khoản</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/change-password"><i class="bx bx-bell me-1"></i>Đổi mật khẩu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register-store"><i class="bx bx-link-alt me-1"></i> Bật bán hàng </a>
                        </li>
                    </ul>
                    <div class="card mb-4">
                        <h5 class="card-header"></h5>
                        <!-- Account -->
                        <div class="card-body">
                            <div class="d-flex align-items-start align-items-sm-center gap-4">
                    <EditForm Model="storeModel" OnValidSubmit="HandleRegisterStore">
                        <DataAnnotationsValidator />
                        
                        <div class="row">
                            @* --- Cột trái: Thông tin --- *@
                            <div class="col-md-7">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Tên cửa hàng <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="storeModel.Name" class="form-control" placeholder="Ví dụ: Bida Shop Sài Gòn" />
                                    <ValidationMessage For="@(() => storeModel.Name)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                    <InputText @bind-Value="storeModel.Phone" class="form-control" placeholder="Số hotline cửa hàng" />
                                    <ValidationMessage For="@(() => storeModel.Phone)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Địa chỉ kho/lấy hàng <span class="text-danger">*</span></label>
                                    <InputTextArea @bind-Value="storeModel.Address" class="form-control" rows="2" placeholder="Địa chỉ cụ thể để shipper đến lấy hàng" />
                                    <ValidationMessage For="@(() => storeModel.Address)" class="text-danger small" />
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Mô tả cửa hàng</label>
                                    <InputTextArea @bind-Value="storeModel.Description" class="form-control" rows="3" placeholder="Giới thiệu đôi chút về shop của bạn..." />
                                    <ValidationMessage For="@(() => storeModel.Description)" class="text-danger small" />
                                </div>
                            </div>

                            @* --- Cột phải: Logo --- *@
                            <div class="col-md-5 text-center d-flex flex-column align-items-center justify-content-center border-start">
                                <label class="form-label fw-bold mb-3">Logo cửa hàng</label>
                                
                                <div class="position-relative mb-3">
                                    <img src="@(ImagePreview ?? "/assets/img/shop-placeholder.png")" 
                                         class="rounded-circle border shadow-sm" 
                                         style="width: 150px; height: 150px; object-fit: cover;" />
                                    
                                    <label class="btn btn-sm btn-icon btn-primary rounded-circle position-absolute bottom-0 end-0 shadow" 
                                           style="cursor: pointer;">
                                        <i class="bx bx-camera"></i>
                                        <InputFile OnChange="HandleLogoSelection" hidden accept=".jpg,.png,.jpeg" />
                                    </label>
                                </div>
                                <small class="text-muted">Ảnh vuông, tối đa 2MB</small>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3 d-flex align-items-center">
                            <i class='bx bx-info-circle me-2 fs-4'></i>
                            <div>
                                Sau khi đăng ký thành công, bạn cần <strong>đăng nhập lại</strong> để hệ thống cập nhật quyền quản lý cửa hàng của bạn.
                            </div>
                        </div>

                        <div class="mt-4 text-center">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <span><i class='bx bx-check-circle'></i> Xác nhận mở Shop</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@code {
    private CreateStoreDto storeModel = new();
    private bool isSubmitting = false;
    private string? ImagePreview;
    private const int MaxFileSize = 2 * 1024 * 1024; // 2MB

    private async Task HandleLogoSelection(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > MaxFileSize)
            {
                await JSRuntime.InvokeVoidAsync("alert", "File quá lớn!");
                return;
            }

            var format = "image/jpeg";
            var resizedFile = await file.RequestImageFileAsync(format, 300, 300);
            var buffer = new byte[resizedFile.Size];
            await resizedFile.OpenReadStream().ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            
            ImagePreview = $"data:{format};base64,{base64}";
            storeModel.LogoUrl = ImagePreview;
        }
    }

    private async Task HandleRegisterStore()
    {
        isSubmitting = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/stores/register", storeModel);
            if (res.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Chúc mừng! Bạn đã trở thành người bán hàng.");
                
                // QUAN TRỌNG: Logout user để họ đăng nhập lại và nhận Token mới có Role "Store"
                // Bạn cần gọi hàm Logout từ AuthenticationStateProvider hoặc Service của bạn
                // Ví dụ: Navigation.NavigateTo("/logout");
                
                // Hoặc chuyển hướng tạm thời:
                Navigation.NavigateTo("/store/dashboard"); 
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi hệ thống: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}