@page "/admin/manage-posts"

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-pills mb-3" role="tablist">
            <li class="nav-item">
                <a href="/admin/manage-accounts" class="nav-link">
                    <i class="bx bx-user me-1"></i> Tài khoản
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-stores" class="nav-link">
                    <i class="bx bx-store me-1"></i> Cửa hàng
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-categories" class="nav-link">
                    <i class="bx bx-category me-1"></i> Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-brands" class="nav-link">
                    <i class="bx bx-purchase-tag me-1"></i> Thương hiệu
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-posts" class="nav-link active">
                    <i class="bx bx-news me-1"></i> Bài viết
                </a>
            </li>
        </ul>

        <div class="tab-content shadow-sm">

            <div class="tab-pane fade show active" id="navs-accounts" role="tabpanel">
                @if (IsLoading)
                {
                    <MiniSpinner></MiniSpinner>
                }
                else
                {
                    <div class="mb-3 d-flex justify-content-between align-items-center">

                        <div class="input-group w-50">
                            <InputText @bind-Value="Author"
                                       class="form-control"
                                       placeholder="Tác giả:">
                            </InputText>
                            <InputText @bind-Value="PostTitle"
                                       class="form-control"
                                       placeholder="Tiêu đề:.">
                            </InputText>
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => SearchPosts()">
                                <i class="bx bx-search"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tiêu đề</th>
                                    <th>Tác giả</th>
                                    <th>Ngày đăng</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Posts)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="text-wrap" style="max-width: 300px;">
                                            <strong>@item.Title</strong>
                                        </td>
                                        <td>
                                            @item.Store.StoreName
                                        </td>
                                        <td>
                                            @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge bg-label-@(item.IsActive == true ? "success" : "secondary")">
                                                @(item.IsActive == true ? "Hiển thị" : "Ẩn")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="form-check form-switch d-flex">
                                                <InputCheckbox @bind-Value="item.IsActive"
                                                               @oninput="() => TogglePostActiveStatus(item)"
                                                               class="form-check-input" />
                                            </div>
                                            <button class="btn btn-sm btn-icon text-danger" @onclick="() => DeleteItem(item.Id)">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">Trang @Model.PageIndex / @Model.TotalPages | Tổng số @Model.TotalCount bài viết.</small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-left" @onclick="() => ChangePostPage(Model.PageIndex - 1)"></button>
                                </li>

                                @for (int i = 1; i <= Math.Min(Model.TotalPages, 5); i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(Model.PageIndex == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePostPage(pageNumber)">@pageNumber</button>
                                    </li>
                                }

                                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-right" @onclick="() => ChangePostPage(Model.PageIndex + 1)"></button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>

        </div>
    </div>
</div>



@code {
    private PostPerPage Model { get; set; } = new();

    private bool IsLoading { get; set; }
    private int PageIndex { get; set; } = 1;
    private const int PageSize = 7;

    private string? Author { get; set; }
    private string? PostTitle { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        var result = await Http.GetFromJsonAsync<PostPerPage>($"api/posts?pageIndex={1}&pageSize={PageSize}");
        if (result != null) Model = result;
        IsLoading = false;
    }

    private async Task ChangePostPage(int newPageIndex)
    {
        if (newPageIndex < 1 || newPageIndex > Model.TotalPages)
            return;

        PageIndex = newPageIndex;

        var queryString = BuildQueryString();

        var response = await Http.GetAsync(
            $"api/posts?pageIndex={PageIndex}&pageSize={PageSize}&{queryString}"
        );

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<PostPerPage>();
            if (result != null)
                Model = result;
        }

        Navigation.NavigateWithFragmentQuery(
            $"#posts/p{PageIndex}",
            queryString
        );
    }

    private async Task SearchPosts()
    {
        PageIndex = 1;

        var queryString = BuildQueryString();

        var response = await Http.GetAsync(
            $"api/posts?pageIndex={PageIndex}&pageSize={PageSize}&{queryString}"
        );

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<PostPerPage>();
            if (result != null)
                Model = result;
        }

        Navigation.NavigateWithFragmentQuery(
            "#posts",
            queryString
        );
    }

    private string BuildQueryString()
    {
        var query = new List<string>();

        if (!string.IsNullOrWhiteSpace(Author))
            query.Add($"author={Uri.EscapeDataString(Author)}");

        if (!string.IsNullOrWhiteSpace(PostTitle))
            query.Add($"title={Uri.EscapeDataString(PostTitle)}");

        return string.Join("&", query);
    }

    private async Task TogglePostActiveStatus(PostDto post)
    {
        bool newStatus = post.IsActive;
        post.IsActive = !newStatus;
        var response = await PostService.UpdateItemAsync(post);

        if (response)
        {
        }
        else
        {
            post.IsActive = !newStatus;
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: Cập nhật trạng thái cửa hàng thất bại. Đã khôi phục trạng thái cũ.");
        }
    }

    private async Task DeleteItem(int id) { bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa bài viết này?"); if (confirmed) { await PostService.DeleteItemAsync(id); } }
}