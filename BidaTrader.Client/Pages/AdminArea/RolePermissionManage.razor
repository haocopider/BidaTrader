@page "/admin/manage-permissions"

<PageTitle>Quản lý Phân quyền</PageTitle>

<div class="container-fluid py-4">
    <div class="card shadow border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary"><i class="bx bx-shield-quarter me-2"></i>Phân quyền vai trò</h5>
            <button class="btn btn-primary" @onclick="SavePermissions" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bx bx-save"></i> Lưu thay đổi
            </button>
        </div>

        <div class="card-body">
            @if (IsLoading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-3 border-end">
                        <h6 class="text-uppercase text-muted small fw-bold mb-3">Chọn Vai Trò</h6>
                        <div class="list-group list-group-flush">
                            @foreach (var role in Roles)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(SelectedRole?.Id == role.Id ? "active" : "")"
                                        @onclick="() => SelectRole(role)">
                                    @role.Name
                                    <span class="badge bg-white text-primary rounded-pill">@role.AssignedPermissionIds.Count</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="col-md-9 ps-md-4">
                        @if (SelectedRole == null)
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bx bx-user-pin fs-1 mb-2"></i>
                                <p>Vui lòng chọn một vai trò bên trái để cấp quyền.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between mb-3">
                                <h6 class="fw-bold">Quyền hạn cho: <span class="text-primary">@SelectedRole.Name</span></h6>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="selectAll" @onchange="ToggleAllPermissions">
                                    <label class="form-check-label" for="selectAll">Chọn tất cả</label>
                                </div>
                            </div>

                            <div class="row g-3" style="max-height: 600px; overflow-y: auto;">
                                @* Gom nhóm Permission theo Prefix (Ví dụ: PRODUCT, ORDER, SYSTEM) *@
                                @foreach (var group in GroupedPermissions)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card h-100 border shadow-sm">
                                            <div class="card-header bg-light py-2">
                                                <div class="form-check m-0">
                                                    @* Checkbox chọn cả nhóm *@
                                                    <input class="form-check-input" type="checkbox"
                                                           checked="@IsGroupSelected(group.Value)"
                                                           @onchange="@(e => ToggleGroup(group.Value, e.Value))">
                                                    <label class="form-check-label fw-bold small text-uppercase">
                                                        @group.Key
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="card-body p-2">
                                                @foreach (var perm in group.Value)
                                                {
                                                    <div class="form-check mb-1">
                                                        <input class="form-check-input" type="checkbox"
                                                               id="perm_@perm.Id"
                                                               checked="@SelectedRole.AssignedPermissionIds.Contains(perm.Id)"
                                                               @onchange="@(e => TogglePermission(perm.Id, e.Value))">
                                                        <label class="form-check-label small text-truncate d-block"
                                                               for="perm_@perm.Id" title="@perm.Description">
                                                            @perm.Name
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<RoleWithPermissionsDto> Roles = new();
    private List<Permission> AllPermissions = new();
    // Dictionary để gom nhóm: Key là tên nhóm (VD: Product), Value là list quyền
    private Dictionary<string, List<Permission>> GroupedPermissions = new();

    private RoleWithPermissionsDto? SelectedRole;
    private bool IsLoading = true;
    private bool IsSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load song song Role và Permission
            var rolesTask = Http.GetFromJsonAsync<List<RoleWithPermissionsDto>>("api/accounts/with-permissions");
            var permsTask = Http.GetFromJsonAsync<List<Permission>>("api/accounts/permissions");

            await Task.WhenAll(rolesTask, permsTask);

            Roles = await rolesTask ?? new();
            AllPermissions = await permsTask ?? new();

            // Logic gom nhóm: Tách theo dấu chấm (.) đầu tiên. VD: Product.View -> Nhóm Product
            GroupedPermissions = AllPermissions
                .GroupBy(p => p.Code.Contains('.') ? p.Code.Split('.')[0] : "Chung")
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi tải dữ liệu: " + ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectRole(RoleWithPermissionsDto role)
    {
        // Clone object để tránh binding trực tiếp vào list gốc khi chưa save
        // Tuy nhiên ở đây làm đơn giản ta tham chiếu trực tiếp để UI update tức thì
        SelectedRole = role;
    }

    private void TogglePermission(int permId, object? isChecked)
    {
        if (SelectedRole == null) return;

        if ((bool)(isChecked ?? false))
        {
            if (!SelectedRole.AssignedPermissionIds.Contains(permId))
                SelectedRole.AssignedPermissionIds.Add(permId);
        }
        else
        {
            SelectedRole.AssignedPermissionIds.Remove(permId);
        }
    }

    // Xử lý chọn cả nhóm
    private void ToggleGroup(List<Permission> permissions, object? isChecked)
    {
        if (SelectedRole == null) return;
        bool check = (bool)(isChecked ?? false);

        foreach (var p in permissions)
        {
            if (check)
            {
                if (!SelectedRole.AssignedPermissionIds.Contains(p.Id))
                    SelectedRole.AssignedPermissionIds.Add(p.Id);
            }
            else
            {
                SelectedRole.AssignedPermissionIds.Remove(p.Id);
            }
        }
    }

    // Kiểm tra xem cả nhóm đã được chọn chưa (để check cái checkbox cha)
    private bool IsGroupSelected(List<Permission> permissions)
    {
        if (SelectedRole == null) return false;
        return permissions.All(p => SelectedRole.AssignedPermissionIds.Contains(p.Id));
    }

    private void ToggleAllPermissions(ChangeEventArgs e)
    {
        if (SelectedRole == null) return;
        bool check = (bool)(e.Value ?? false);

        SelectedRole.AssignedPermissionIds.Clear();
        if (check)
        {
            SelectedRole.AssignedPermissionIds.AddRange(AllPermissions.Select(p => p.Id));
        }
    }

    private async Task SavePermissions()
    {
        if (SelectedRole == null) return;
        IsSaving = true;

        var dto = new UpdateRolePermissionsDto
        {
            RoleId = SelectedRole.Id,
            PermissionIds = SelectedRole.AssignedPermissionIds
        };

        var response = await Http.PutAsJsonAsync("api/accounts/update-permissions", dto);

        if (response.IsSuccessStatusCode)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Đã cập nhật quyền thành công!");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Có lỗi xảy ra khi lưu.");
        }

        IsSaving = false;
    }
}