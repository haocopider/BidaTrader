@page "/admin/manage-brands"

<PageTitle>Quản lý thương hiệu</PageTitle>
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-pills mb-3" role="tablist">
            <li class="nav-item">
                <a href="/admin/manage-accounts" class="nav-link">
                    <i class="bx bx-user me-1"></i> Tài khoản
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-stores" class="nav-link">
                    <i class="bx bx-store me-1"></i> Cửa hàng
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-categories" class="nav-link">
                    <i class="bx bx-category me-1"></i> Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-brands" class="nav-link active">
                    <i class="bx bx-purchase-tag me-1"></i> Thương hiệu
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-posts" class="nav-link">
                    <i class="bx bx-news me-1"></i> Bài viết
                </a>
            </li>
        </ul>

        <div class="tab-content shadow-sm">

            <div class="tab-pane fade show active" id="navs-accounts" role="tabpanel">

                @if (IsLoading)
                {
                    <MiniSpinner></MiniSpinner>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var b in Model.Brands)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @b.Id./ @b.Name
                                <span>
                                    <img src="@b.Description" alt="@b.Name" style="height: 40px;" />
                                </span>
                                <span>
                                    <button @onclick="() => ShowBrandModel(b.Id)" class="btn btn-sm btn-icon"><i class="bx bx-edit"></i></button>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">
                            Trang @Model.PageIndex / @Model.TotalPages | Tổng số @Model.TotalCount thương hiệu.
                        </small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-left" @onclick="() => ChangeBrandPage(Model.PageIndex - 1)"></button>
                                </li>
                                @for (int i = 1; i <= Math.Min(Model.TotalPages, 5); i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(Model.PageIndex == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangeBrandPage(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-right" @onclick="() => ChangeBrandPage(Model.PageIndex + 1)"></button>
                                </li>
                            </ul>
                        </nav>
                    </div>

                }
            </div>

        </div>
    </div>
</div>


<BrandForm Id="currentId" 
    IsVisible="isBrandFormVisible" 
    OnClose="CloseModel"
    OnDataSaved="RefreshBrandData" />

@code{
    private BrandPerPage Model { get; set; }
    private int currentId { get; set; }
    private bool isBrandFormVisible { get; set; }
    private bool IsLoading { get; set; }
    private const int PageSize = 7;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        var result = await Http.GetFromJsonAsync<BrandPerPage>($"api/brands?pageIndex={1}&pageSize={PageSize}");
        if (result != null) Model = result;
        IsLoading = false;
    }

    private async Task ChangeBrandPage(int newPageIndex)
    {
        if (newPageIndex > 0 && newPageIndex <= Model.TotalPages)
        {
            var queryString = $"api/brands?pageIndex={newPageIndex}&pageSize={PageSize}";
            var response = await Http.GetAsync(queryString);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BrandPerPage>();
                if (result != null) Model = result;
            }
        }
        Navigation.NavigateWithFragmentQuery($"/p{newPageIndex}");
    }

    private void ShowBrandModel(int id)
    {
        currentId = id;
        isBrandFormVisible = true;
    }

    private async Task CloseModel()
    {
        isBrandFormVisible = false;
    }

    private async Task RefreshBrandData()
    {
        await CloseModel();
        await ChangeBrandPage(Model.PageIndex);
    }

}