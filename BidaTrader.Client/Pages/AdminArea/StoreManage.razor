@page "/admin/manage-stores"
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-pills mb-3" role="tablist">
            <li class="nav-item">
                <a href="/admin/manage-accounts" class="nav-link">
                    <i class="bx bx-user me-1"></i> Tài khoản
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-stores" class="nav-link active">
                    <i class="bx bx-store me-1"></i> Cửa hàng
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-categories" class="nav-link">
                    <i class="bx bx-category me-1"></i> Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-brands" class="nav-link">
                    <i class="bx bx-purchase-tag me-1"></i> Thương hiệu
                </a>
            </li>
            <li class="nav-item">
                <a href="/admin/manage-posts" class="nav-link">
                    <i class="bx bx-news me-1"></i> Bài viết
                </a>
            </li>
        </ul>

        <div class="tab-content shadow-sm">

            <div class="tab-pane fade show active" id="navs-accounts" role="tabpanel">
                @if (IsLoading)
                {
                    <MiniSpinner></MiniSpinner>
                }
                else
                {
                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Tên Cửa Hàng</th>
                                    <th>Liên hệ</th>
                                    <th>Địa chỉ</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Stores)
                                {
                                    <tr>
                                        <td><strong>@item.Id</strong></td>
                                        <td>
                                            <span class="fw-bold text-primary">@item.StoreName</span>
                                        </td>
                                        <td>@item.Phone</td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@item.Address">
                                            @item.Address
                                        </td>
                                        <td>
                                            <span class="badge bg-label-@(item.IsActive == true ? "success" : "danger") me-1">
                                                @(item.IsActive == true ? "Hoạt động" : "Khóa")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="form-check form-switch d-inline-block">
                                                <InputCheckbox @bind-Value="item.IsActive"
                                                               @oninput="() => ToggleStoreActiveStatus(item)"
                                                               class="form-check-input" />
                                                <a style="cursor: pointer;" @onclick="() => GoToStore(item.Id)"><i class="bi bi-arrow-bar-right"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">
                            Trang @Model.PageIndex / @Model.TotalPages | Tổng số @Model.TotalCount cửa hàng.
                        </small>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-left" @onclick="() => ChangeStorePage(Model.PageIndex - 1)"></button>
                                </li>
                                @for (int i = 1; i <= Math.Min(Model.TotalPages, 5); i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(Model.PageIndex == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangeStorePage(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-right" @onclick="() => ChangeStorePage(Model.PageIndex + 1)"></button>
                                </li>
                            </ul>
                        </nav>
                    </div>

                }
            </div>

        </div>
    </div>
</div>




@code {
    private StorePerPage Model { get; set; }
    private bool IsLoading { get; set; }

    private const int PageSize = 7;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        var result = await Http.GetFromJsonAsync<StorePerPage>($"api/stores?pageIndex={1}&pageSize={PageSize}");
        if (result != null) Model = result;
        IsLoading = false;
    }

    private async Task ChangeStorePage(int newPageIndex)
    {
        if (newPageIndex > 0 && newPageIndex <= Model.TotalPages)
        {
            var queryString = $"api/stores?pageIndex={newPageIndex}&pageSize={PageSize}";
            var response = await Http.GetAsync(queryString);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<StorePerPage>();
                if (result != null) Model = result;
            }
        }
    }

    private async Task ToggleStoreActiveStatus(StoreDto store)
    {
        bool newStatus = store.IsActive;
        store.IsActive = !newStatus;
        var response = await StoreService.UpdateItemAsync(store);

        if (response)
        {
        }
        else
        {
            store.IsActive = !newStatus;
            await JSRuntime.InvokeVoidAsync("alert", $"Lỗi: Cập nhật trạng thái cửa hàng thất bại. Đã khôi phục trạng thái cũ.");
        }
    }

    private void GoToStore(int storeId)
    {
        Navigation.NavigateTo($"store/{storeId}");
    }
}