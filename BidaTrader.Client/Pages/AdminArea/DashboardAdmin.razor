@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin")]

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="nav-align-top mb-4">
        <ul class="nav nav-pills mb-3" role="tablist">
            <li class="nav-item">
                <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#navs-accounts" aria-controls="navs-accounts" aria-selected="true">
                    <i class="bx bx-user me-1"></i> Tài khoản
                </button>
            </li>
            <li class="nav-item">
                <button @onclick="() => LoadStoreData()" type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-stores" aria-controls="navs-stores" aria-selected="false">
                    <i class="bx bx-store me-1"></i> Cửa hàng
                </button>
            </li>
            <li class="nav-item">
                <button @onclick="() => LoadCategoryData()" type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-categories" aria-controls="navs-categories" aria-selected="false">
                    <i class="bx bx-category me-1"></i> Danh mục
                </button>
            </li>
            <li class="nav-item">
                <button @onclick="() => LoadBrandData()" type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-brands" aria-controls="navs-brands" aria-selected="false">
                    <i class="bx bx-purchase-tag me-1"></i> Thương hiệu
                </button>
            </li>
            <li class="nav-item">
                <button @onclick="() => LoadPostData()"  type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#navs-posts" aria-controls="navs-posts" aria-selected="false">
                    <i class="bx bx-news me-1"></i> Bài viết
                </button>
            </li>
        </ul>

        <div class="tab-content shadow-sm">

            <div class="tab-pane fade show active" id="navs-accounts" role="tabpanel">
                @if (IsLoadingAccounts)
                {
                    <div class="text-center p-3"><div class="spinner-border text-primary" role="status"></div></div>
                }
                else if (ErrorMessage != null)
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
                else
                {
                    <AccountManage Model="AccountPerPage" />
                }
            </div>

           
            <div class="tab-pane fade" id="navs-stores" role="tabpanel">
                @if (IsLoadingStores)
                {
                    <p>Đang tải dữ liệu...</p>
                }
                else if (StorePerPage.Stores == null)
                {
                    <p>Lỗi tải dữ liệu</p>
                }
                else
                {
                    <StoreManage Model="StorePerPage"></StoreManage>
                }
            </div>

            @* --- TAB 3: QUẢN LÝ DANH MỤC --- *@
            <div class="tab-pane fade" id="navs-categories" role="tabpanel">
                @if (IsLoadingCategories)
                {
                    <p>Đang tải dữ liệu...</p>
                } else if(CategoryPerPage.Categories == null)
                {
                    <p>Lỗi tải dữ liệu</p>
                }
                else
                {
                    <CategoryManage Model="CategoryPerPage"></CategoryManage>
                }
            </div>

            @* --- TAB 4: QUẢN LÝ THƯƠNG HIỆU --- *@
            <div class="tab-pane fade" id="navs-brands" role="tabpanel">
                @if (IsLoadingBrands)
                {
                    <p>Đang tải...</p>
                } else if(BrandPerPage.Brands == null)
                {
                    <p>Lỗi tải dữ liệu</p>
                }
                else
                {
                    <BrandManage Model="BrandPerPage"></BrandManage>
                }
            </div>

            <div class="tab-pane fade" id="navs-posts" role="tabpanel">
                @if (IsLoadingPosts)
                {
                    <p>Đang tải dữ liệu...</p>
                }
                else if (PostPerPage.Posts == null)
                {
                    <p>Lỗi tải dữ liệu</p>
                }
                else
                {
                    <PostManage Model="PostPerPage"></PostManage>
                }
            </div>
           
        </div>
    </div>
</div>


@code {
    private bool IsLoadingAccounts = true;
    private bool IsLoadingCategories = false;
    private bool IsLoadingBrands = false;
    private bool IsLoadingStores = false;
    private bool IsLoadingPosts = false;
    private string? ErrorMessage;

    private AccountPerPage AccountPerPage { get; set; } = new();
    private CategoryPerPage CategoryPerPage { get; set; } = new();
    private BrandPerPage BrandPerPage { get; set; } = new();
    private StorePerPage StorePerPage { get; set; } = new();
    private PostPerPage PostPerPage { get; set; } = new();
    private const int PageSize = 7;
    private const int pageIndex = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountData();
    }

    private async Task<T?> LoadDataFromApi<T>(string endpoint) where T : class
    {
        try
        {
            var response = await Http.GetAsync(endpoint);
            if (response.IsSuccessStatusCode)
            {
                return await response.Content.ReadFromJsonAsync<T>();
            }
            else
            {
                ErrorMessage = $"Lỗi tải dữ liệu từ {endpoint}: {response.StatusCode}";
                return null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi kết nối/Serialization: {ex.Message}";
            return null;
        }
    }

    private async Task LoadAccountData()
    {
        IsLoadingAccounts = true;
        var result = await LoadDataFromApi<AccountPerPage>($"api/accounts?pageIndex={pageIndex}&pageSize={PageSize}");
        if (result != null) AccountPerPage = result;
        IsLoadingAccounts = false;
        StateHasChanged();
    }

    private async Task LoadCategoryData()
    {
        IsLoadingCategories = true;
        var result = await LoadDataFromApi<CategoryPerPage>($"api/categories?pageIndex={pageIndex}&pageSize={PageSize}");
        if (result != null) CategoryPerPage = result;
        IsLoadingCategories = false;
        StateHasChanged();
    }

    private async Task LoadBrandData()
    {
        IsLoadingBrands = true;
        var result = await LoadDataFromApi<BrandPerPage>($"api/brands?pageIndex={pageIndex}&pageSize={PageSize}");
        if (result != null) BrandPerPage = result;
        IsLoadingBrands = false;
        StateHasChanged();
    }

    private async Task LoadStoreData()
    {
        IsLoadingStores = true;
        var result = await LoadDataFromApi<StorePerPage>($"api/stores?pageIndex={pageIndex}&pageSize={PageSize}");
        if (result != null) StorePerPage = result;
        IsLoadingStores = false;
        StateHasChanged();
    }

    private async Task LoadPostData()
    {
        IsLoadingPosts = true;
        var result = await LoadDataFromApi<PostPerPage>($"api/posts?pageIndex={pageIndex}&pageSize={PageSize}");
        if (result != null) PostPerPage = result;
        IsLoadingPosts = false;
        StateHasChanged();
    }
}