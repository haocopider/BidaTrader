@page "/store/{StoreId:int}"

<PageTitle>@storeInfo.StoreName - BidaTrader</PageTitle>

@if(loading)
{
    <MiniSpinner />
}
else
{
    <div class="container-fluid py-4 bg-light">

        <div class="card border-0 shadow-sm mb-4 overflow-hidden">

            <div class="card-body position-relative pt-0 p-4">
                <div class="row align-items-end">
                    <div class="col-auto">
                        <div class="position-relative">
                            <img src="@storeInfo.LogoUrl"
                                 class="rounded-circle border border-4 border-white shadow"
                                 style="width: 120px; height: 120px; object-fit: cover;" alt="Logo">
                            <span class="position-absolute bottom-0 end-0 p-2 bg-success border border-light rounded-circle" title="Online"></span>
                        </div>
                    </div>

                    <div class="col-md-5 mb-3 mb-md-0">
                        <h3 class="fw-bold mb-1">
                            @storeInfo.StoreName
                            <i class="bi bi-patch-check-fill text-primary" title="Cửa hàng chính hãng"></i>
                        </h3>
                        <p class="text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @storeInfo.Address</p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary btn-sm px-4 rounded-pill">
                                <i class="bi bi-plus-lg"></i> Theo dõi
                            </button>
                            <button class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                <i class="bi bi-chat-dots-fill"></i> Chat ngay
                            </button>
                        </div>
                    </div>

                    <div class="col-md-auto ms-auto">
                        <div class="d-flex gap-4 text-center">
                            <div>
                                <div class="fw-bold fs-5">@storeInfo.TotalProducts</div>
                                <small class="text-muted">Sản phẩm</small>
                            </div>
                            <div class="border-start mx-1"></div>
                            <div>
                                <div class="fw-bold fs-5 text-warning">@storeInfo.Rating <i class="bi bi-star-fill fs-6"></i></div>
                                <small class="text-muted">Đánh giá</small>
                            </div>
                            <div class="border-start mx-1"></div>
                            <div>
                                <div class="fw-bold fs-5">@storeInfo.Followers</div>
                                <small class="text-muted">Người theo dõi</small>
                            </div>
                            <div class="border-start mx-1"></div>
                            <div>
                                <div class="fw-bold fs-5">@((DateTime.Now - storeInfo.JoinDate).Days)</div>
                                <small class="text-muted">Ngày tham gia</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (storeInfo.BannerImages != null && storeInfo.BannerImages.Any())
        {
            <div id="storeCarousel" class="carousel slide mb-4 shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < storeInfo.BannerImages.Count; i++)
                    {
                        <button type="button" data-bs-target="#storeCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                    }
                </div>
                <div class="carousel-inner" style="max-height: 350px;">
                    @for (int i = 0; i < storeInfo.BannerImages.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@storeInfo.BannerImages[i]" class="d-block w-100 object-fit-cover" alt="Banner @i">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#storeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#storeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-lg-3 mb-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0"><i class="bi bi-funnel"></i> Bộ lọc Store</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Tìm trong shop</label>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Tên sản phẩm..." @bind="filter.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                                <button class="btn btn-outline-secondary" @onclick="LoadProducts"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-uppercase text-muted">Danh mục</label>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="cat" id="catAll" checked="@(filter.CategoryId == 0)" @onchange="() => UpdateCategory(0)">
                                    <label class="form-check-label" for="catAll">Tất cả sản phẩm</label>
                                </div>
                                @foreach (var cat in categories)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="cat" id="cat-@cat.Id" checked="@(filter.CategoryId == cat.Id)" @onchange="() => UpdateCategory(cat.Id)">
                                        <label class="form-check-label" for="cat-@cat.Id">@cat.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-muted">Khoảng giá</label>
                            <select class="form-select mb-2" @onchange="OnSortChange">
                                <option value="newest">Mới nhất</option>
                                <option value="price_asc">Giá: Thấp đến Cao</option>
                                <option value="price_desc">Giá: Cao đến Thấp</option>
                                <option value="best_sell">Bán chạy nhất</option>
                            </select>
                        </div>

                        <button class="btn btn-primary w-100" @onclick="LoadProducts">Áp dụng</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Danh sách sản phẩm </h5>
                </div>

                @if (isLoading)
                {
                    <MiniSpinner></MiniSpinner>
                }
                else if (Products.Items.Count == 0)
                {
                    <div class="alert alert-warning text-center">Không tìm thấy sản phẩm nào trong cửa hàng này.</div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                        @foreach (var p in Products.Items)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border-0 product-card-hover">
                                    <div class="position-relative overflow-hidden">
                                        <img src="@p.ImageUrl"
                                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="@p.Name">
                                        @if (p.Quantity == 0)
                                        {
                                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex align-items-center justify-content-center text-white fw-bold">
                                                HẾT HÀNG
                                            </div>
                                        }
                                    </div>

                                    <div class="card-body p-3 d-flex flex-column">
                                        <h6 class="card-title text-truncate mb-1" title="@p.Name">
                                            <a href="/product/@p.Id" class="text-decoration-none text-dark stretched-link">@p.Name</a>

                                        </h6>
                                        <div class="mb-2">
                                            <span class="text-warning small"><i class="bi bi-star-fill"></i> 4.8</span>
                                            <span class="text-muted small ms-1">(Đã bán 120)</span>
                                        </div>
                                        <div class="mt-auto d-flex justify-content-between align-items-center">
                                            <span class="text-primary fw-bold">@p.Price.ToString("N0")₫</span>
                                            <button class="btn btn-outline-primary btn-sm rounded-circle position-relative z-index-2"><i class="bi bi-cart-plus"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-center mt-5">
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Products.PageIndex == 1 ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-left" @onclick="() => ChangePage(Products.PageIndex - 1)"></button>
                                </li>
                                @for (int i = 1; i <= Math.Min(Products.TotalPages, 5); i++)
                                {
                                    var pageNumber = i;
                                    <li class="page-item @(Products.PageIndex == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                                    </li>
                                }
                                <li class="page-item @(Products.PageIndex == Products.TotalPages ? "disabled" : "")">
                                    <button class="page-link bi bi-arrow-right" @onclick="() => ChangePage(Products.PageIndex + 1)"></button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int StoreId { get; set; }

    private StoreDto storeInfo = new StoreDto();
    private ProductPerPage Products { get; set; } = new();
    private List<CategoryDto> categories = new List<CategoryDto>();
    private string ErrorMessage { get; set; } = "";

    private FilterModel filter = new FilterModel();
    private bool isLoading = true;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStoreInfo();
        await LoadCategories();
        await LoadProducts();
        loading = false;
    }

    private async Task LoadStoreInfo()
    {
        var store = await StoreService.GetItemByIdAsync(StoreId);
        if(store != null)
        {
            storeInfo = store;
        }
        else
        {
            ErrorMessage = "Không có dữ liệu trả về từ Server";
        }
        await Task.Delay(300);
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        await Task.Delay(500);

        var response = await Http.GetAsync($"api/products/store/{StoreId}");
        if(response.IsSuccessStatusCode)
        {
            var data = await response.Content.ReadFromJsonAsync<ProductPerPage>();
            Products = data;
        }

        isLoading = false;
    }

    private async Task LoadCategories()
    {
        var response = await CategoryService.GetItemsAsync("/all");
        if (response != null) categories = response;
        else ErrorMessage = "Không có dữ liệu category trả về từ Server";
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadProducts();
    }

    private async Task UpdateCategory(int catId)
    {
        filter.CategoryId = catId;
        await LoadProducts();
    }

    private async Task OnSortChange(ChangeEventArgs e)
    {
        filter.SortOption = e.Value.ToString();
        await LoadProducts();
    }

    private async Task ChangePage(int newPageIndex)
    {
        if (newPageIndex > 0 && newPageIndex <= Products.TotalPages)
        {
            var response = await Http.GetAsync($"api/products/store/{StoreId}?pageIndex={newPageIndex}&pageSize=20");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ProductPerPage>();
                if (result != null) Products = result;
            }
        }
    }

    public class FilterModel
    {
        public string SearchTerm { get; set; } = "";
        public int CategoryId { get; set; } = 0;
        public string SortOption { get; set; } = "newest";
    }

}