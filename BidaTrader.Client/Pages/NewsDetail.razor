@page "/news/{Id:int}"

<PageTitle>Chi tiết tin tức</PageTitle>

<div class="container py-4">
    @if (Post != null)
    {
        <article class="mb-5">
            <h1 class="fw-bold mb-3">@Post.Title</h1>
            <div class="text-muted mb-4 small">
                <i class="bx bx-user"></i> @(Post.Store?.StoreName ?? "Admin") |
                <i class="bx bx-calendar"></i> @Post.CreatedAt.ToString("dd/MM/yyyy")
            </div>
            @if (!string.IsNullOrEmpty(Post.ThumbnailUrl))
            {
                <img src="@Post.ThumbnailUrl" class="img-fluid rounded mb-4 w-100" style="max-height:400px; object-fit:cover">
            }
            <div class="post-content">
                @((MarkupString)Post.Content)
            </div>
        </article>

        <hr />

        <div class="comments-section">
            <h5 class="fw-bold mb-3">Bình luận (@Post.Comments.Count)</h5>

            <div class="mb-4 d-flex gap-2">
                <input class="form-control" placeholder="Viết bình luận..." @bind="NewComment">
                <button class="btn btn-primary" @onclick="SendComment"><i class="bx bx-send"></i></button>
            </div>

            @foreach (var cmt in Post.Comments)
            {
                <div class="d-flex mb-3">
                    <div class="bg-light p-2 px-3 rounded">
                        <strong class="d-block small">@cmt.Account?.UserName</strong>
                        <span class="text-dark">@cmt.Content</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private PostDto? Post;
    private string NewComment = "";

    protected override async Task OnInitializedAsync()
    {
        Post = await Http.GetFromJsonAsync<PostDto>($"api/posts/{Id}");
    }

    private async Task SendComment()
    {
        if (string.IsNullOrWhiteSpace(NewComment)) return;

        var dto = new CreateCommentDto { PostId = Id, Content = NewComment };
        await Http.PostAsJsonAsync("api/posts/comment", dto);

        // Reload lại bài viết để thấy comment mới
        Post = await Http.GetFromJsonAsync<PostDto>($"api/posts/{Id}");
        NewComment = "";
    }
}