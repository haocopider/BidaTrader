@inject ToastHelper ToastService
@implements IDisposable

@if (isToast)
{
    <div class="toast-top-center">
        <div class="bs-toast toast fade show bg-@ToastClass slide-down shadow"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="toast-header">
                <i class="bx bx-bell me-2"></i>
                <strong class="me-auto">@Title</strong>
                <small class="text-muted">@time.ToString("HH:mm")</small>
                <button class="btn-close ms-2" @onclick="Hide"></button>
            </div>

            <div class="toast-body">
                @Messages
            </div>
        </div>
    </div>
}



@code {
    private bool isToast;
    private string Title = string.Empty;
    private string Messages = string.Empty;
    private string ToastClass = "success";
    private DateTime time;

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private async void ShowToast(string title, string message, string type)
    {
        Title = title;
        Messages = message;
        ToastClass = type;
        time = DateTime.Now;
        isToast = true;

        StateHasChanged();

        // ⏱ Auto close sau 3s
        await Task.Delay(3000);
        Hide();
    }

    private void Hide()
    {
        isToast = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }
}

