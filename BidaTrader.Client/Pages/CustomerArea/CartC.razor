@page "/my-cart"
@attribute [Authorize]

<PageTitle>Giỏ hàng</PageTitle>

<div class="container py-4">
    <div class="row">
        @* --- CỘT TRÁI: DANH SÁCH SẢN PHẨM --- *@
        <div class="col-lg-8">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">Đang tải giỏ hàng...</p>
                </div>
            }
            else if (CartGroup.Count == 0)
            {
                <div class="card shadow-sm border-0 text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Giỏ hàng của bạn đang trống</h5>
                        <p class="text-muted">Hãy thêm sản phẩm để tiến hành mua sắm nhé!</p>
                        <a href="/" class="btn btn-primary mt-2">Tiếp tục mua sắm</a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var storeGroup in CartGroup)
                {
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-header bg-white d-flex align-items-center py-3">
                            <div class="form-check m-0">
                                <input class="form-check-input" type="checkbox" 
                                       checked="@storeGroup.IsSelected" 
                                       @onchange="(e) => ToggleStore(storeGroup, e.Value)">
                            </div>
                            <i class="bi bi-shop ms-3 me-2 text-primary"></i>
                            <span class="fw-bold me-auto">@storeGroup.StoreName</span>
                            <button class="btn btn-sm btn-outline-primary rounded-pill">
                                <i class="bi bi-chat-dots"></i> Chat
                            </button>
                        </div>

                        <div class="card-body p-0">
                            @foreach (var item in storeGroup.Items)
                            {
                                <div class="p-3 border-bottom d-flex align-items-center">
                                    @* Checkbox sản phẩm *@
                                    <div class="form-check me-3">
                                        <input class="form-check-input" type="checkbox" 
                                               checked="@item.IsSelected" 
                                               @onchange="(e) => ToggleItem(item, e.Value)">
                                    </div>

                                    @* Ảnh sản phẩm *@
                                    <img src="@item.ProductImage" class="rounded border" 
                                         style="width: 80px; height: 80px; object-fit: cover;" />

                                    @* Thông tin sản phẩm *@
                                    <div class="ms-3 flex-grow-1">
                                        <h6 class="mb-1 text-truncate" style="max-width: 300px;">
                                            <a href="/product/@item.ProductId" class="text-decoration-none text-dark">
                                                @item.ProductName
                                            </a>
                                        </h6>
                                        <div class="text-danger fw-bold">@item.Price.ToString("N0") ₫</div>
                                    </div>

                                    @* Bộ điều khiển số lượng *@
                                    <div class="d-flex flex-column align-items-end">
                                        <div class="input-group input-group-sm mb-2" style="width: 110px;">
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="() => UpdateQuantity(item.ProductId, item.Quantity - 1)"
                                                    disabled="@(item.Quantity <= 1)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <input type="text" class="form-control text-center bg-white"
                                                   value="@item.Quantity" readonly />
                                            <button class="btn btn-outline-secondary"
                                                    @onclick="() => UpdateQuantity(item.ProductId, item.Quantity + 1)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        
                                        @* Nút Xóa *@
                                        <button class="btn btn-link text-danger text-decoration-none p-0 small"
                                                @onclick="() => DeleteItem(item.ProductId)">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        @* Footer của Shop: Voucher & Vận chuyển *@
                        <div class="card-footer bg-light py-2">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-6 d-flex align-items-center">
                                    <i class="bi bi-ticket-perforated text-danger me-2"></i>
                                    <select class="form-select form-select-sm border-0 bg-transparent">
                                        <option>Chọn Voucher Shop...</option>
                                        <option>GIAM10K - Giảm 10k</option>
                                    </select>
                                </div>
                                <div class="col-md-6 d-flex align-items-center border-start">
                                    <i class="bi bi-truck text-success me-2 ps-2"></i>
                                    <select class="form-select form-select-sm border-0 bg-transparent" @bind="shippingMethod">
                                        <option value="Standard">Nhanh (30k)</option>
                                        <option value="Express">Hỏa tốc (50k)</option>
                                        <option value="Economy">Tiết kiệm (15k)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @* --- CỘT PHẢI: THANH TOÁN --- *@
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 position-sticky" style="top: 20px;">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Thanh toán</h5>

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính (@selectedCount sp):</span>
                        <span>@subTotal.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span>@shippingTotal.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Giảm giá:</span>
                        <span class="text-success">- @discountTotal.ToString("N0") ₫</span>
                    </div>
                    
                    <hr />
                    
                    <div class="d-flex justify-content-between mb-4 align-items-center">
                        <span class="fw-bold">Tổng cộng:</span>
                        <span class="fw-bold fs-4 text-danger">
                            @((subTotal + shippingTotal - discountTotal).ToString("N0")) ₫
                        </span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted">Phương thức thanh toán</label>
                        
                        <div class="list-group">
                            <label class="list-group-item d-flex gap-3 align-items-center list-group-item-action cursor-pointer">
                                <input class="form-check-input flex-shrink-0" type="radio" name="payment" 
                                       checked="@(selectedPayment == PaymentMethod.COD)"
                                       @onchange="@(() => selectedPayment = PaymentMethod.COD)">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <span>
                                        <i class="bi bi-cash me-2"></i>Thanh toán khi nhận hàng
                                    </span>
                                </div>
                            </label>

                            <label class="list-group-item d-flex gap-3 align-items-center list-group-item-action cursor-pointer">
                                <input class="form-check-input flex-shrink-0" type="radio" name="payment" 
                                       checked="@(selectedPayment == PaymentMethod.VNPay)"
                                       @onchange="@(() => selectedPayment = PaymentMethod.VNPay)">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <span class="text-primary fw-bold">
                                        <i class="bi bi-bank me-2"></i>VNPay QR
                                    </span>
                                    <img src="https://vnpay.vn/s1/statics.vnpay.vn/2023/9/06ncktiwd6dc1694418196384.png" height="20" />
                                </div>
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(checkoutError))
                    {
                        <div class="alert alert-danger small mb-3">
                            <i class="bi bi-exclamation-circle me-1"></i> @checkoutError
                        </div>
                    }

                    <button class="btn btn-primary w-100 py-3 fw-bold shadow-sm"
                            disabled="@(isCheckingOut || selectedCount == 0)"
                            @onclick="Checkout">
                        @if (isCheckingOut)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Đang xử lý...</span>
                        }
                        else
                        {
                            <span>@(selectedPayment == PaymentMethod.VNPay ? "THANH TOÁN NGAY" : "ĐẶT HÀNG")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CartGroupDto> CartGroup { get; set; } = new List<CartGroupDto>();
    bool isLoading = true;
    private enum ShippingMethod { Standard, Express, Economy }
    private ShippingMethod shippingMethod { get; set; }

    // Biến tính toán
    double subTotal = 0;
    double shippingTotal = 0;
    double discountTotal = 0;
    int selectedCount = 0;

    // Biến thanh toán
    private enum PaymentMethod { COD, VNPay }
    private PaymentMethod selectedPayment = PaymentMethod.COD;
    bool isCheckingOut = false;
    string? checkoutError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        isLoading = true;
        var response = await Http.GetAsync("/api/cart");
        if (response.IsSuccessStatusCode)
        {
            CartGroup = await response.Content.ReadFromJsonAsync<List<CartGroupDto>>() ?? new();
        }
        isLoading = false;
    }

    // --- LOGIC CHỌN SẢN PHẨM & TÍNH TIỀN ---
    private void ToggleStore(CartGroupDto group, object checkedValue)
    {
        bool isChecked = (bool)checkedValue;
        group.IsSelected = isChecked;
        foreach (var item in group.Items) item.IsSelected = isChecked;
        CalculateTotal();
    }

    private void ToggleItem(CartItemDto item, object checkedValue)
    {
        item.IsSelected = (bool)checkedValue;
        
        var group = CartGroup.FirstOrDefault(g => g.Items.Contains(item));
        if (group != null)
        {
            group.IsSelected = group.Items.All(i => i.IsSelected);
        }

        CalculateTotal();
    }

    private void CalculateTotal()
    {
        subTotal = 0;
        selectedCount = 0;
        shippingTotal = 0;
        discountTotal = 0;

        foreach (var group in CartGroup)
        {
            bool hasSelectedItemInStore = false;
            foreach (var item in group.Items)
            {
                if (item.IsSelected)
                {
                    subTotal += (Double)(item.Price * item.Quantity);
                    selectedCount++;
                    hasSelectedItemInStore = true;
                }
            }
            
            if (hasSelectedItemInStore) 
            {
                shippingTotal += 30000;
            }
        }
    }


    private async Task UpdateQuantity(int productId, int quantity)
    {
        var updated = new AddToCartDto { ProductId = productId, Quantity = quantity };
        var response = await Http.PutAsJsonAsync("api/cart/update", updated);
        if (response.IsSuccessStatusCode)
        {
            foreach(var g in CartGroup) {
                var item = g.Items.FirstOrDefault(i => i.ProductId == productId);
                if(item != null) item.Quantity = quantity;
            }
            CalculateTotal();
        }
    }

    private async Task DeleteItem(int productId)
    {
        if(!await JSRuntime.InvokeAsync<bool>("confirm", "Bạn muốn xóa sản phẩm này khỏi giỏ hàng?")) return;

        var response = await Http.DeleteAsync($"api/cart/{productId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadCart();
            CalculateTotal();
        }
        else 
        {
            await JSRuntime.InvokeVoidAsync("alert", "Lỗi xóa sản phẩm");
        }
    }

    // --- CHECKOUT ---

    private async Task Checkout()
    {
        checkoutError = null;
        var selectedItems = CartGroup.SelectMany(g => g.Items)
                                     .Where(i => i.IsSelected)
                                     .Select(i => new CheckoutItemDto { ProductId = i.ProductId, Quantity = i.Quantity })
                                     .ToList();

        if (!selectedItems.Any())
        {
            checkoutError = "Vui lòng chọn ít nhất 1 sản phẩm để thanh toán.";
            return;
        }

        isCheckingOut = true;

        var request = new CheckoutRequestDto
        {
            SelectedItems = selectedItems,
            PaymentMethod = selectedPayment.ToString(),
            ShippingAddress = "123 Test Street",
            PhoneNumber = "0909000000"
        };

        var response = await Http.PostAsJsonAsync("/api/cart/checkout", request);

        if (!response.IsSuccessStatusCode)
        {
            checkoutError = await response.Content.ReadAsStringAsync();
            isCheckingOut = false;
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<CheckoutResultDto>();
        isCheckingOut = false;

        if (selectedPayment == PaymentMethod.VNPay)
        {
            await ProcessVnPay(result!.OrderId, result.TotalAmount, "VNPAY", "vn");
        }
        else
        {
            await LoadCart();
            CalculateTotal();
            Navigation.NavigateTo("/my-orders");
        }
    }

    private async Task ProcessVnPay(int orderId, long amount, string bankcode, string local)
    {
        var paymentRequest = new PaymentRequestDto
        {
            OrderId = orderId,
            Amount = amount,
            BankCode = bankcode,
            Local = local
        };

        var response = await Http.PostAsJsonAsync("api/cart/create-vnpay-url", paymentRequest);

        if (response.IsSuccessStatusCode)
        {
            var res = await response.Content.ReadFromJsonAsync<JsonElement>();
            var payUrl = res.GetProperty("payUrl").GetString();

            if (!string.IsNullOrEmpty(payUrl)) Navigation.NavigateTo(payUrl, forceLoad: true);
            else checkoutError = "Lỗi: Không lấy được link thanh toán.";
        }
        else
        {
            checkoutError = "Lỗi kết nối cổng thanh toán.";
        }
    }
}