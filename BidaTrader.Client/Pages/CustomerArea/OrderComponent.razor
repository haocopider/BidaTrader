<div class="card shadow-sm mb-2">
    <div class="card-body p-2">
        <div class="d-flex justify-content-between small text-muted">
            <span>@Order.StoreName</span>
            <span>@Order.Id</span>
        </div>
        <div class="d-flex mt-2 gap-2">
            <img src="@Order.Image" width="50" height="50" class="rounded" />
            <div>
                <p class="mb-0 fw-bold text-truncate" style="max-width: 150px;">@Order.ProductName</p>
                <span class="text-danger">@Order.Total.ToString("N0") ₫</span>
            </div>
        </div>
        @if (IsCompleted)
        {
            <button class="btn btn-sm btn-outline-warning w-100 mt-2">
                <i class="bi bi-star"></i> Đánh giá ngay
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary w-100 mt-2">Chi tiết</button>
        }
    </div>
</div>

@code {
    [Parameter] public OrderMock Order { get; set; }
    [Parameter] public bool IsCompleted { get; set; } = false;
}