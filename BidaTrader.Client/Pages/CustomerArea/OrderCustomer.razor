@page "/my-orders"
@attribute [Authorize]

<div class="container-fluid py-4">
    <h4 class="mb-4">Theo dõi đơn hàng</h4>
    
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card bg-light h-100 border-0">
                <div class="card-header bg-warning text-white fw-bold text-center">
                    <i class="bi bi-hourglass-split"></i> Chờ xác nhận
                </div>
                <div class="card-body p-2 scroll-y" style="max-height: 80vh; overflow-y:auto;">
                    @foreach(var order in orders.Where(o => o.Status == OrderStatus.Pending))
                    {
                        <OrderCardComponent Order="order" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light h-100 border-0">
                <div class="card-header bg-info text-white fw-bold text-center">
                    <i class="bi bi-box-seam"></i> Chờ lấy hàng
                </div>
                <div class="card-body p-2" style="max-height: 80vh; overflow-y:auto;">
                    @foreach(var order in orders.Where(o => o.Status == OrderStatus.Processing))
                    {
                        <OrderCardComponent Order="order" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light h-100 border-0">
                <div class="card-header bg-primary text-white fw-bold text-center">
                    <i class="bi bi-truck"></i> Đang giao
                </div>
                <div class="card-body p-2" style="max-height: 80vh; overflow-y:auto;">
                    @foreach(var order in orders.Where(o => o.Status == OrderStatus.Shipping))
                    {
                        <OrderCardComponent Order="order" />
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-light h-100 border-0">
                <div class="card-header bg-success text-white fw-bold text-center">
                    <i class="bi bi-check-circle"></i> Đã giao & Đánh giá
                </div>
                <div class="card-body p-2" style="max-height: 80vh; overflow-y:auto;">
                    @foreach(var order in orders.Where(o => o.Status == OrderStatus.Completed))
                    {
                         <OrderCardComponent Order="order" IsCompleted="true" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>




@code {
    // --- Mock Data & Enums ---


    List<OrderMock> orders = new();

    protected override void OnInitialized()
    {
        // Tạo dữ liệu giả
        orders.Add(new OrderMock { Id="ORD001", StoreName="Shop A", ProductName="Găng tay", Total=150000, Status=OrderStatus.Pending, Image="/assets/img/elements/1.jpg" });
        orders.Add(new OrderMock { Id="ORD002", StoreName="Shop B", ProductName="Cơ Bida", Total=2000000, Status=OrderStatus.Processing, Image="/assets/img/elements/2.jpg" });
        orders.Add(new OrderMock { Id="ORD003", StoreName="Shop C", ProductName="Lơ", Total=50000, Status=OrderStatus.Shipping, Image="/assets/img/elements/3.jpg" });
        orders.Add(new OrderMock { Id="ORD004", StoreName="Shop A", ProductName="Bàn Bida", Total=15000000, Status=OrderStatus.Completed, Image="/assets/img/elements/4.jpg" });
    }
}