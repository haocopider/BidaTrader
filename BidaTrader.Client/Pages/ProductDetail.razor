        // var bestSellerData = await ProductService.GetProductsAsync(new ProductSearchDto { SortBy = "sold_desc", PageSize = 5 });
        // bestSellers = bestSellerData.Items;

        StateHasChanged(); // Cập nhật lại UI sau khi tải xong dữ liệu phụ
    }

    private void IncreaseQty()
    {
        if (product != null && quantity < product.Quantity) quantity++;
    }

    private void DecreaseQty()
    {
        if (quantity > 1) quantity--;
    }

    private async Task AddToCart()
    {
        var request = new AddToCartDto
            {
                ProductId = product.Id,
                Quantity = quantity
            };

        var response = await Http.PostAsJsonAsync("api/cart/add", request);

        if(response.IsSuccessStatusCode)
        {

