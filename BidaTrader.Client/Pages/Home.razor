@page "/"


<PageTitle>BidaTrader - Sàn Thương Mại Bida Hàng Đầu</PageTitle>


<div class="hero-section text-center mb-5">
    <div class="hero-overlay"></div>

    <div class="container position-relative z-1">
        <h1 class="display-5 fw-bold mb-3 animate__animated animate__fadeInDown">
            Khám Phá Thế Giới Bida
        </h1>

        <p class="lead mb-4 opacity-75 animate__animated animate__fadeInUp">
            Cơ gậy, phụ kiện và bàn bida chất lượng từ những cửa hàng uy tín nhất.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <button class="btn btn-light rounded-pill px-4 fw-bold text-primary shadow-sm"
                    @onclick="ScrollToProducts">
                <i class="bx bx-shopping-bag me-1"></i> Mua ngay
            </button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5" id="product-list-section">
    <div class="row g-4">
        <aside class="col-lg-3 col-xl-3">
            <div class="card border-0 shadow-sm sticky-top" style="top: 85px; border-radius: 12px;">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-package me-2"></i>Sản phẩm</h6>
                        <div class="input-group input-group-merge border rounded-pill overflow-hidden">
                            <span class="input-group-text border-0 bg-white"><i class="bx bx-search"></i></span>
                            <input type="text" class="form-control border-0 shadow-none ps-0"
                                   placeholder="Tên sản phẩm..."
                                   @bind="SearchTerm"
                                   @bind:event="oninput"
                                   @onkeyup="HandleSearchEnter" />
                        </div>
                        @if (!string.IsNullOrEmpty(SearchTerm))
                        {
                            <div class="form-text text-primary small ms-2 animate__animated animate__fadeIn">
                                Đang lọc theo sản phẩm...
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-store me-2"></i>Cửa hàng</h6>
                        <div class="input-group input-group-merge border rounded-pill overflow-hidden">
                            <span class="input-group-text border-0 bg-white"><i class="bx bx-buildings"></i></span>
                            <input type="text" class="form-control border-0 shadow-none ps-0"
                                   placeholder="Tên cửa hàng..."
                                   @bind="StoreSearchTerm"
                                   @bind:event="oninput"
                                   @onkeyup="HandleSearchEnter" />
                        </div>
                        @if (!string.IsNullOrEmpty(StoreSearchTerm))
                        {
                            <div class="form-text text-primary small ms-2 animate__animated animate__fadeIn">
                                Đang lọc theo cửa hàng...
                            </div>
                        }
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 text-uppercase small text-muted"><i class="bx bx-wallet me-2"></i>Giá (VNĐ)</h6>
                        <div class="d-flex flex-column gap-2 ms-1">
                            <label class="form-check-label custom-option custom-option-basic rounded">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(SelectedPriceRange == PriceRange.None)" @onclick="() => SelectPrice(PriceRange.None)">
                                <span>Tất cả giá</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(SelectedPriceRange == PriceRange.OneToThree)" @onclick="() => SelectPrice(PriceRange.OneToThree)">
                                <span>1tr - 3tr</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(SelectedPriceRange == PriceRange.ThreeToFive)" @onclick="() => SelectPrice(PriceRange.ThreeToFive)">
                                <span>3tr - 5tr</span>
                            </label>
                            <label class="form-check-label custom-option custom-option-basic">
                                <input class="form-check-input me-2" type="radio" name="priceRange"
                                       checked="@(SelectedPriceRange == PriceRange.OverTen)" @onclick="() => SelectPrice(PriceRange.OverTen)">
                                <span>Trên 10tr</span>
                            </label>
                        </div>

                        <div class="mt-4 px-1">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small text-muted">Dưới:</span>
                                <span class="fw-bold text-primary">@MaxPriceSlider.ToString("N0")</span>
                            </div>
                            <input type="range" class="form-range" min="0" max="50000000" step="500000"
                                   @bind="MaxPriceSlider" @bind:event="oninput" @onchange="OnSliderChanged">
                        </div>
                    </div>
                </div>
            </div>
        </aside>
        <main class="col-lg-9 col-xl-9">

            <div class="d-lg-none mb-4">
                <div class="category-scroll">
                    <div class="cat-pill @(SelectedCategoryId == null ? "active" : "")" @onclick="() => SelectCategory(null)">Tất cả</div>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <div class="cat-pill @(SelectedCategoryId == cat.Id ? "active" : "")"
                                 @onclick="() => SelectCategory(cat.Id)">
                                @cat.Name
                            </div>
                        }
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-5">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                </div>
            }
            else if (Products.Items.Count == 0)
            {
                <div class="text-center py-5">
                    <img src="/assets/img/illustrations/girl-doing-yoga-light.png" alt="Empty" style="width: 200px; opacity: 0.8;" class="mb-3">
                    <h5 class="fw-bold text-secondary">Không tìm thấy sản phẩm nào!</h5>
                    <p class="text-muted">Thử thay đổi từ khóa hoặc bộ lọc giá xem sao nhé.</p>
                    <button class="btn btn-primary rounded-pill shadow-sm" @onclick="ResetFilters">Xem tất cả sản phẩm</button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @if (SelectedCategoryId.HasValue || !string.IsNullOrEmpty(SearchTerm))
                    {
                        <span class="badge bg-label-primary rounded-pill">Đang lọc kết quả</span>
                    }
                </div>

                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 g-lg-4">
                    @foreach (var product in Products.Items)
                    {
                        <div class="col">
                            <div class="card product-card h-100 position-relative overflow-hidden bg-white">

                                @* --- BADGE TRẠNG THÁI (Mới / Hot) --- *@
                                @if (IsNewProduct(product.CreatedAt))
                                {
                                    <span class="badge bg-success badge-float rounded-pill shadow-sm">Mới</span>
                                }
                                else if (product.Rating >= 4.5)
                                {
                                    <span class="badge bg-warning text-dark badge-float rounded-pill shadow-sm"><i class="bi bi-fire"></i> Hot</span>
                                }

                                @* --- HÌNH ẢNH SẢN PHẨM --- *@
                                <div class="ratio ratio-1x1 bg-light position-relative">
                                    @* Logic: Nếu hết hàng thì làm mờ ảnh (opacity-50) *@
                                    <img src="@product.ImageUrl"
                                         class="card-img-top object-fit-cover @(product.Quantity <= 0 ? "opacity-50" : "")"
                                         alt="@product.Name"
                                         style="cursor: pointer;"
                                         @onclick='() => Navigation.NavigateTo($"/product/{product.Id}")'>


                                    @* Thông tin cửa hàng (Overlay bên dưới ảnh) *@
                                    <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-to-t"
                                         style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
                                        <div class="d-flex align-items-center text-white" style="cursor: pointer;"
                                             @onclick='() => Navigation.NavigateTo($"/store/{product.StoreId}")'>
                                            <img src="@product.StoreLogo" class="rounded-circle border border-white" width="24" height="24">
                                            <small class="ms-2 text-truncate fw-medium" style="max-width: 80%;">@product.StoreName</small>
                                        </div>
                                    </div>
                                </div>

                                @* --- BODY THẺ SẢN PHẨM --- *@
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="mb-auto">
                                        <h6 class="card-title text-truncate-2 mb-1" style="font-size: 0.95rem; min-height: 2.4em; line-height: 1.2em;">
                                            <a href="/product/@product.Id" class="text-dark text-decoration-none stretched-link">@product.Name</a>
                                        </h6>
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="d-flex text-warning small me-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= product.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </div>

                                            @* Logic: Hiển thị text trạng thái kho *@
                                            @if (product.Quantity > 0)
                                            {
                                                <small class="text-muted" style="font-size: 0.75rem;">(Còn @product.Quantity)</small>
                                            }
                                            else
                                            {
                                                <div class="out-of-stock-overlay">
                                                    <span class="badge bg-danger fs-6 px-3 py-2 shadow">Hết hàng</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                        <div class="fw-bold text-primary" style="font-size: 1.1rem;">
                                            @product.Price.ToString("N0")<span class="small align-top text-decoration-underline">đ</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

<style>

    .product-card {
        transition: all 0.3s ease;
        border-radius: 14px;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.12);
        }

        .product-card img {
            transition: transform 0.4s ease;
        }

        .product-card:hover img {
            transform: scale(1.05);
        }

    .out-of-stock-overlay {
        position: absolute;
        inset: 0;
        background-color: transparent ;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 5;
        backdrop-filter: blur(1px);
    }

</style>

<div class="pagination-fixed">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-vertical">
            <li class="page-item @(Products.PageIndex == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(Products.PageIndex - 1)">
                    <i class="bx bx-chevron-up"></i>
                </button>
            </li>

            @{
                int currentPage = Products.PageIndex;
                int totalPages = Products.TotalPages;
                int delta = 2;
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNumber = i;
                if (i == 1 || (i >= currentPage - delta && i <= currentPage + delta) || i == totalPages)
                {
                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                    </li>
                }
                else if ((i == currentPage - delta - 1 && i > 1) || (i == currentPage + delta + 1 && i < totalPages))
                {
                    <li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted small">...</span></li>
                }
            }

            <li class="page-item @(Products.PageIndex == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(Products.PageIndex + 1)">
                    <i class="bx bx-chevron-down"></i>
                </button>
            </li>
        </ul>
    </nav>
</div>

@code {
    public ProductPerPage Products { get; set; } = new();
    private List<CategoryDto>? categories = new();
    private bool isLoading = true;

    private string SearchTerm { get; set; } = "";
    private string StoreSearchTerm { get; set; } = "";
    private int? SelectedCategoryId { get; set; }
    private PriceRange SelectedPriceRange { get; set; } = PriceRange.None;
    private decimal MaxPriceSlider { get; set; } = 50000000;
    private const int PageSize = 20; // Giảm xuống 20 để load nhanh hơn và đẹp grid hơn

    private enum PriceRange { None = 0, OneToThree = 1, ThreeToFive = 2, FiveToTen = 3, OverTen = 4 }

    protected override async Task OnInitializedAsync()
    {
        await LoadMetaData();
        ParseUrlParameters();
        await LoadProducts();
    }

    private string GetPriceLabel(PriceRange range) => range switch
    {
        PriceRange.None => "Tất cả giá",
        PriceRange.OneToThree => "1tr - 3tr",
        PriceRange.ThreeToFive => "3tr - 5tr",
        PriceRange.FiveToTen => "5tr - 10tr",
        PriceRange.OverTen => "Trên 10tr",
        _ => ""
    };

    private bool IsNewProduct(DateTime? createdAt)
    {
        if (!createdAt.HasValue) return false;
        return (DateTime.Now - createdAt.Value).TotalDays < 7;
    }

    private async Task ScrollToProducts()
    {
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 500);
    }


    private void ParseUrlParameters()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("pname", out var search)) SearchTerm = search!;
        if (query.TryGetValue("sname", out var store)) StoreSearchTerm = store!;
        if (query.TryGetValue("categoryId", out var cid)) SelectedCategoryId = int.Parse(cid!);

        if (query.TryGetValue("minPrice", out var min))
        {
            var minVal = decimal.Parse(min!);
            SelectedPriceRange = minVal switch
            {
                1000000 => PriceRange.OneToThree,
                3000000 => PriceRange.ThreeToFive,
                5000000 => PriceRange.FiveToTen,
                10000000 => PriceRange.OverTen,
                _ => PriceRange.None
            };
        }
        else if (query.TryGetValue("maxPrice", out var maxOnly))
        {
            MaxPriceSlider = decimal.Parse(maxOnly!);
        }
    }

    private async Task HandleSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        { 
            await Task.Yield();
            await ApplyFilters();
        }

    }

    private async Task SelectCategory(int? id)
    {
        SelectedCategoryId = id;
        await ApplyFilters();
    }

    private async Task SelectPrice(PriceRange range)
    {
        SelectedPriceRange = range;
        MaxPriceSlider = 50000000;
        await Task.Yield();
        await ApplyFilters();
    }

    private async Task OnSliderChanged()
    {
        SelectedPriceRange = PriceRange.None; 
        await Task.Yield();
        await ApplyFilters();
    }

    private async Task ResetFilters()
    {
        SearchTerm = ""; StoreSearchTerm = ""; SelectedCategoryId = null;
        SelectedPriceRange = PriceRange.None; MaxPriceSlider = 50000000;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var query = new Dictionary<string, string>();
        if (!string.IsNullOrWhiteSpace(SearchTerm)) query["pname"] = SearchTerm;
        if (!string.IsNullOrWhiteSpace(StoreSearchTerm)) query["sname"] = StoreSearchTerm;
        if (SelectedCategoryId.HasValue) query["categoryId"] = SelectedCategoryId.Value.ToString();

        switch (SelectedPriceRange)
        {
            case PriceRange.OneToThree: query["minPrice"] = "1000000"; query["maxPrice"] = "3000000"; break;
            case PriceRange.ThreeToFive: query["minPrice"] = "3000000"; query["maxPrice"] = "5000000"; break;
            case PriceRange.FiveToTen: query["minPrice"] = "5000000"; query["maxPrice"] = "10000000"; break;
            case PriceRange.OverTen: query["minPrice"] = "10000000"; break;
            case PriceRange.None:
                if (MaxPriceSlider < 50000000) query["maxPrice"] = MaxPriceSlider.ToString();
                break;
        }

        var queryString = string.Join("&", query.Select(q => $"{q.Key}={Uri.EscapeDataString(q.Value)}"));
        Navigation.NavigateTo($"/?{queryString}", forceLoad: false);
        await LoadProducts(1);
    }

    private async Task LoadProducts(int pageIndex = 1)
    {
        isLoading = true;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        var finalQuery = queryParams.ToDictionary(x => x.Key, x => x.Value.ToString());

        finalQuery["pageIndex"] = pageIndex.ToString();
        finalQuery["pageSize"] = PageSize.ToString();

        try
        {
            var apiQuery = string.Join("&", finalQuery.Select(q => $"{q.Key}={Uri.EscapeDataString(q.Value)}"));
            var response = await Http.GetAsync($"/api/products/home?{apiQuery}");
            if (response.IsSuccessStatusCode)
            {
                Products = await response.Content.ReadFromJsonAsync<ProductPerPage>() ?? new();
            }
        }
        catch { Products = new(); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadMetaData() => categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories/all");

    private async Task ChangePage(int newPageIndex)
    {
        if (newPageIndex < 1 || newPageIndex > Products.TotalPages) return;
        await LoadProducts(newPageIndex);
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private async Task AddToCart(int productId)
    {
        var request = new AddToCartDto { ProductId = productId, Quantity = 1 };
        var response = await Http.PostAsJsonAsync("api/cart/add", request);
    }
}