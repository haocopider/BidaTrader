@page "/"

<style>
    /* Container pagination */
    .pagination-fixed {
        position: fixed;
        top: 50%;
        right: 18px;
        transform: translateY(-50%);
        z-index: 1050;
    }

    /* Pagination dọc */
    .pagination-vertical {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        /* Button mặc định */
        .pagination-vertical .page-link {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            padding: 0;
            text-align: center;
            line-height: 44px;
            font-weight: 600;
            background: linear-gradient(145deg, #f8f9ff, #e9ecff);
            color: #3b5bff;
            border: 1px solid #d6ddff;
            box-shadow: 0 4px 10px rgba(59, 91, 255, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.6);
            transition: all 0.25s ease;
        }

            /* Hover */
            .pagination-vertical .page-link:hover {
                background: linear-gradient(145deg, #3b5bff, #5c7cff);
                color: #fff;
                transform: translateY(-2px) scale(1.05);
                box-shadow: 0 8px 18px rgba(59, 91, 255, 0.35);
            }

        /* Trang đang active */
        .pagination-vertical .page-item.active .page-link {
            background: linear-gradient(145deg, #20c997, #38d9a9);
            border-color: #20c997;
            color: #fff;
            box-shadow: 0 8px 20px rgba(32, 201, 151, 0.45);
        }

        /* Disabled */
        .pagination-vertical .page-item.disabled .page-link {
            background: #f1f3f5;
            color: #adb5bd;
            border-color: #dee2e6;
            box-shadow: none;
            cursor: not-allowed;
        }

    /* CSS bổ sung để hiệu ứng mượt mà hơn */
    .transition-hover {
        transition: all 0.3s ease;
    }

        .transition-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
        }

    .zoom-effect {
        transition: transform 0.5s ease;
    }

    .product-card:hover .zoom-effect {
        transform: scale(1.1);
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .border-radius-top {
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
    }
</style>

<PageTitle>Trang chủ - BidaTrader</PageTitle>

<div class="container-fluid py-4">
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body border-top border-4 border-primary rounded-top">
            <div class="row g-3">

                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white border-primary">
                            <i class="bi bi-grid-fill"></i>
                        </span>
                        <select class="form-select border-primary text-primary fw-bold"
                                style="--bs-bg-opacity: .1; background-color: rgba(var(--bs-primary-rgb), .1);"
                                @onchange="OnCategoryChanged">
                            <option value="0" class="text-dark">📂 Danh mục sản phẩm</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" class="text-dark">@cat.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-success text-white border-success">
                            <i class="bi bi-cash-coin"></i>
                        </span>
                        <select class="form-select border-success text-success fw-bold"
                                style="background-color: rgba(var(--bs-success-rgb), .1);"
                                @bind="filter.SortPrice">
                            <option value="none" class="text-dark">💰 Giá bán</option>
                            <option value="asc" class="text-dark">📈 Thấp đến Cao</option>
                            <option value="desc" class="text-dark">📉 Cao đến Thấp</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-info text-white border-info">
                            <i class="bi bi-clock-history"></i>
                        </span>
                        <select class="form-select border-info text-info fw-bold"
                                style="background-color: rgba(var(--bs-info-rgb), .1);"
                                @bind="filter.SortDate">
                            <option value="none" class="text-dark">📅 Thời gian</option>
                            <option value="newest" class="text-dark">✨ Mới nhất</option>
                            <option value="oldest" class="text-dark">🕰️ Cũ nhất</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-warning text-white border-warning">
                            <i class="bi bi-star-fill"></i>
                        </span>
                        <select class="form-select border-warning text-warning fw-bold"
                                style="background-color: rgba(var(--bs-warning-rgb), .1);"
                                @bind="filter.MinRating">
                            <option value="0" class="text-dark">⭐ Đánh giá</option>
                            <option value="5" class="text-dark">⭐⭐⭐⭐⭐ (5 Sao)</option>
                            <option value="4" class="text-dark">⭐⭐⭐⭐ (4+ Sao)</option>
                            <option value="3" class="text-dark">⭐⭐⭐ (3+ Sao)</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>
    </div>
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Đang tải sản phẩm...</p>
        </div>
    }
    else if (Products.Items == null || Products.Items.Count == 0)
    {
        <div class="alert alert-warning text-center" role="alert">
            <i class="bi bi-exclamation-triangle"></i> Không tìm thấy sản phẩm nào phù hợp với tiêu chí lọc.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Products.Items)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm product-card border-0 transition-hover">
                        <div class="position-relative overflow-hidden border-radius-top">
                            <img src="@product.ImageUrl"
                                 class="card-img-top zoom-effect"
                                 alt="@product.Name"
                                 style="height: 220px; object-fit: cover;">

                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge bg-danger shadow-sm">Yêu thích</span>
                            </div>

                            <div class="position-absolute bottom-0 start-0 m-2 d-flex align-items-center bg-white bg-opacity-75 rounded-pill pe-2 shadow-sm border border-white"
                                 style="backdrop-filter: blur(4px); cursor: pointer;"
                                 @onclick='() => Navigation.NavigateTo($"/store/{product.StoreId}")'>
                                <img src="@product.StoreLogo"
                                     class="rounded-circle border border-2 border-white"
                                     style="width: 32px; height: 32px; object-fit: cover;"
                                     alt="Store Avatar">
                                <small class="ms-1 fw-bold text-dark text-truncate" style="max-width: 80px;">@product.StoreName</small>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title text-dark fw-bold mb-1 text-truncate-2"
                                style="height: 2.4rem; line-height: 1.2rem;" title="@product.Name">
                                @product.Name
                            </h6>

                            <div class="d-flex align-items-center mb-2">
                                <div class="text-warning small me-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= (product.Rating)) // Giả sử dùng biến Rating thật
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {

                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                                <small class="text-muted border-start ps-2">Kho: @product.Quantity</small>
                            </div>

                            <div class="mb-3">
                                <span class="text-primary fw-bolder fs-5">@product.Price.ToString("N0")</span>
                                <span class="text-primary small fw-bold"> VNĐ</span>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a href="/product/@product.Id" class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <button @onclick="() => AddToCart(product.Id)" class="btn btn-primary btn-sm flex-grow-1 rounded-pill shadow-sm">
                                    <i class="bi bi-cart-plus"></i> Thêm
                                </button>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 text-end">
                            <small class="text-muted" style="font-size: 0.7rem;">
                                <i class="bi bi-clock"></i>
                                @(product.UpdatedAt.HasValue? product.UpdatedAt.Value.ToString("dd/MM/yyyy") : product.CreatedAt.Value.ToString("dd/MM/yyyy"))
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="pagination-fixed">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-vertical">
            <li class="page-item @(Products.PageIndex == 1 ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangePage(Products.PageIndex - 1)">
                    ‹
                </button>
            </li>

            @for (int i = 1; i <= Products.TotalPages; i++)
            {
                var pageNumber = i;
                <li class="page-item @(Products.PageIndex == pageNumber ? "active" : "")">
                    <button class="page-link"
                            @onclick="() => ChangePage(pageNumber)">
                        @pageNumber
                    </button>
                </li>
            }

            <li class="page-item @(Products.PageIndex == Products.TotalPages ? "disabled" : "")">
                <button class="page-link"
                        @onclick="() => ChangePage(Products.PageIndex + 1)">
                    ›
                </button>
            </li>
        </ul>
    </nav>
</div>

@code {
    private ProductPerPage Products { get; set; } = new();
    private List<CategoryDto> categories = new List<CategoryDto>();
    private List<BrandDto> brands = new List<BrandDto>();
    private bool isLoading = true;

    private const int PageSize = 20;
    // Biến cho bộ lọc
    private FilterModel filter = new FilterModel();

    public class FilterModel
    {
        public string SearchTerm { get; set; } = "";
        public int CategoryId { get; set; } = 0;
        public int BrandId { get; set; } = 0;
        public string SortPrice { get; set; } = "none"; // none, asc, desc
        public string SortDate { get; set; } = "newest"; // newest, oldest
        public int MinRating { get; set; } = 0;
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Tải danh mục và thương hiệu (Mock data hoặc gọi API thật)
        await LoadMetaData();

        // 2. Tải sản phẩm lần đầu
        await LoadProducts();
    }

    private async Task ChangePage(int newPageIndex)
    {
        if (newPageIndex > 0 && newPageIndex <= Products.TotalPages)
        {
            var queryString = $"api/products/home?pageIndex={newPageIndex}&pageSize={PageSize}";
            var response = await Http.GetAsync(queryString);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ProductPerPage>();
                if (result != null) Products = result;
            }
        }
    }

    private async Task LoadMetaData()
    {
        // TODO: Thay thế bằng call API thực tế: await ClientService.GetCategories();
        // Giả lập dữ liệu
        categories = new List<CategoryDto>
        {
            new CategoryDto { Id = 1, Name = "Cơ Bida (Cues)" },
            new CategoryDto { Id = 2, Name = "Bàn Bida (Tables)" },
            new CategoryDto { Id = 3, Name = "Phụ kiện (Accessories)" }
        };

        brands = new List<BrandDto>
        {
            new BrandDto { Id = 1, Name = "Predator" },
            new BrandDto { Id = 2, Name = "Mezz" },
            new BrandDto { Id = 3, Name = "Mit" }
        };
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        // Giả lập delay mạng
        await Task.Delay(500);

        var response = await Http.GetAsync("/api/products/home?pageIndex=1&pageSize=24");
        if(response.IsSuccessStatusCode)
        {
            var data = await response.Content.ReadFromJsonAsync<ProductPerPage>();
            Products = data;
        }

        isLoading = false;
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        filter.CategoryId = int.Parse(e.Value.ToString());
    }

    private void OnBrandChanged(ChangeEventArgs e)
    {
        filter.BrandId = int.Parse(e.Value.ToString());
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            LoadProducts();
        }
    }

    private async Task ResetFilter()
    {
        filter = new FilterModel();
        await LoadProducts();
    }

    private async Task AddToCart(int productId)
    {
        var request = new AddToCartDto
        {
            ProductId = productId,
            Quantity = 1
        };

        var response = await Http.PostAsJsonAsync("api/cart/add", request);

        if (response.IsSuccessStatusCode)
        {

        }
        else
        {
            // Thất bại
            var error = await response.Content.ReadAsStringAsync();
        }
    }

}