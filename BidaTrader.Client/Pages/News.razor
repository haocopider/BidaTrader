@code {
    private PostPerPage Model { get; set; } = new PostPerPage { Posts = new List<PostDto>(), PageIndex = 1, PageSize = 6 };
    private bool isLoading = true;
    private string? TitleFilter { get; set; }
    private const int PageSize = 6;

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
    }

    private async Task LoadPosts(int pageIndex = 1)
    {
        isLoading = true;
        StateHasChanged();

        // ensure BaseAddress used correctly
        var query = new List<string>();
        query.Add($"pageIndex={pageIndex}");
        query.Add($"pageSize={PageSize}");
        query.Add("isActive=true"); // only show active posts on public news page
        if (!string.IsNullOrWhiteSpace(TitleFilter))
            query.Add($"title={Uri.EscapeDataString(TitleFilter)}");

        var url = $"api/posts?{string.Join("&", query)}";

        try
        {
            var resp = await Http.GetAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<PostPerPage>();
                if (result != null)
                {
                    Model = result;
                }
            }
            else
            {
                Model = new PostPerPage { Posts = new List<PostDto>(), PageIndex = pageIndex, PageSize = PageSize, TotalCount = 0 };
            }
        }
        catch
        {
            Model = new PostPerPage { Posts = new List<PostDto>(), PageIndex = pageIndex, PageSize = PageSize, TotalCount = 0 };
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > Model.TotalPages) return;
        await LoadPosts(newPage);
        await JSRuntimeInvokeScrollTop();
    }

    private async Task Search()
    {
        await LoadPosts(1);
    }

    private void OpenPost(int id)
    {
        Navigation.NavigateTo($"/post/{id}");
    }

    private async Task JSRuntimeInvokeScrollTop()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch { }
    }
}