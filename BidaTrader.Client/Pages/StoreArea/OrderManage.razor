@page "/store/orders"
@attribute [Authorize(Roles = "Store, Admin")]

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between mb-3">
        <h4>Quản lý đơn hàng</h4>
        <button class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i> Làm mới</button>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-warning text-white">
                    <h6 class="mb-0"><i class="bi bi-bell"></i> Đơn mới cần xác nhận</h6>
                </div>
                <div class="card-body p-2 bg-light">
                    @foreach (var order in orders.Where(o => o.Status == "Pending"))
                    {
                        <div class="card mb-2 border-warning border-start border-4">
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between">
                                    <strong>#@order.Id</strong>
                                    <small>@order.Date</small>
                                </div>
                                <p class="mb-1">Khách: @order.CustomerName</p>
                                <p class="mb-2 text-danger fw-bold">@order.Total.ToString("N0") ₫</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success flex-grow-1" @onclick="() => AcceptOrder(order)">
                                        <i class="bi bi-check-lg"></i> Nhận đơn
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelOrder(order)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-box-seam"></i> Đang chuẩn bị hàng</h6>
                </div>
                <div class="card-body p-2 bg-light">
                    @foreach (var order in orders.Where(o => o.Status == "Processing"))
                    {
                        <div class="card mb-2">
                            <div class="card-body p-2">
                                <strong>#@order.Id</strong> - @order.CustomerName
                                <div><span class="badge bg-secondary">Vận chuyển: Nhanh</span></div>
                                <button class="btn btn-sm btn-primary w-100 mt-2" @onclick="() => ShipOrder(order)">
                                    <i class="bi bi-truck"></i> Giao cho Shipper
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-list-check"></i> Đang giao / Lịch sử</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var order in orders.Where(o => o.Status == "Shipping" || o.Status == "Completed"))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold">#@order.Id</span>
                                    <div class="small text-muted">@order.Status</div>
                                </div>
                                <span class="badge @(order.Status == "Completed" ? "bg-success" : "bg-primary")">
                                    @order.Status
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Mock Data Store
    class StoreOrder
    {
        public string Id { get; set; }
        public string CustomerName { get; set; }
        public double Total { get; set; }
        public string Status { get; set; }
        public string Date { get; set; }
    }

    List<StoreOrder> orders = new() {
        new StoreOrder { Id="1001", CustomerName="Phạm Văn B", Total=500000, Status="Pending", Date="10:30 AM" },
        new StoreOrder { Id="1002", CustomerName="Lê Thị C", Total=120000, Status="Processing", Date="Yesterday" },
        new StoreOrder { Id="1003", CustomerName="Trần Văn D", Total=4500000, Status="Shipping", Date="15/12" },
    };

    void AcceptOrder(StoreOrder o) { o.Status = "Processing"; }
    void ShipOrder(StoreOrder o) { o.Status = "Shipping"; }
    void CancelOrder(StoreOrder o) { orders.Remove(o); } // Demo logic
}