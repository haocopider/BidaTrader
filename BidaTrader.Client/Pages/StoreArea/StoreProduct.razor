@page "/store/manage-product"


@if(isToast)
{
    <Toast ToastClass="@classToast" Title="@titleToast" Messages="@messagesToast" OnCLose="CloseToast" ></Toast>
}

<PageTitle>Quản lý sản phẩm - BidaTrader</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i> Kho hàng của tôi</h4>
        <button class="btn btn-primary shadow-sm" @onclick="() => OpenModal(0)">
            <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
        </button>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm tên sản phẩm..."
                               @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @onchange="OnCategoryFilterChanged">
                        <option value="0">Tất cả danh mục</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="statusFilter">
                        <option value="all">Trạng thái: Tất cả</option>
                        <option value="instock">Còn hàng</option>
                        <option value="outofstock">Hết hàng</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase small fw-bold">
                    <tr>
                        <th class="ps-4">Sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (!filteredProducts.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">Không tìm thấy sản phẩm nào.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in filteredProducts)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/assets/img/elements/1.jpg" : p.ImageUrl)"
                                             class="rounded border me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-bold text-dark">@p.Name</div>
                                            <small class="text-muted">ID: #@p.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-label-secondary">@p.CategoryName</span></td>
                                <td class="fw-bold text-primary">@p.Price.ToString("N0") ₫</td>
                                <td>
                                    @if (p.Quantity <= 5)
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> @p.Quantity</span>
                                    }
                                    else
                                    {
                                        <span>@p.Quantity</span>
                                    }
                                </td>
                                <td>
                                    @if (p.Quantity > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 rounded-pill">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 rounded-pill">Hết hàng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm border rounded">
                                        <button class="btn btn-white btn-sm px-3" title="Chỉnh sửa" @onclick="() => OpenModal(p.Id)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                        <button class="btn btn-white btn-sm px-3" title="Xóa" @onclick="() => ConfirmDelete(p)">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted">
        Trang @allProducts.PageIndex / @allProducts.TotalPages | Tổng số @allProducts.TotalCount sản phẩm.
    </small>
    <nav aria-label="Page navigation">
        <ul class="pagination mb-0">
            <li class="page-item @(allProducts.PageIndex == 1 ? "disabled" : "")">
                <button class="page-link bi bi-arrow-left" @onclick="() => ChangePage(allProducts.PageIndex - 1)"></button>
            </li>
            @for (int i = 1; i <= Math.Min(allProducts.TotalPages, 5); i++)
            {
                var pageNumber = i;
                <li class="page-item @(allProducts.PageIndex == pageNumber ? "active" : "")">
                    <button class="page-link" @onclick="() => ChangePage(pageNumber)">@pageNumber</button>
                </li>
            }
            <li class="page-item @(allProducts.PageIndex == allProducts.TotalPages ? "disabled" : "")">
                <button class="page-link bi bi-arrow-right" @onclick="() => ChangePage(allProducts.PageIndex + 1)"></button>
            </li>
        </ul>
    </nav>
</div>

@if (isModalVisible)
{
    <!-- Backdrop -->
    <div class="modal-backdrop fade show"></div>

    <!-- Modal -->
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">

                <!-- HEADER -->
                <div class="modal-header border-bottom">
                    <div>
                        <h5 class="modal-title mb-0 fw-semibold">
                            @(editingProduct.Id == 0
                                                    ? "✨ Thêm sản phẩm mới"
                                                    : $"✏️ Cập nhật sản phẩm")
                        </h5>
                        @if (editingProduct.Id != 0)
                        {
                            <small class="text-muted">
                                ID: #@editingProduct.Id – @editingProduct.Name
                            </small>
                        }
                    </div>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseModal">
                    </button>
                </div>

                <!-- BODY -->
                <div class="modal-body bg-light">

                    @if (isLoadingModal)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary mb-3"></div>
                            <div class="text-muted">Đang tải dữ liệu...</div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white rounded shadow-sm p-4">
                            <ProductForm Product="editingProduct"
                                         Categories="categories"
                                         Brands="brands"
                                         OnValidSubmit="SaveProduct"
                                         OnClose="CloseModal" />
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>
}


@code {
    // 1. Biến quản lý dữ liệu danh sách
    private ProductPerPage allProducts = new();
    private List<ProductDto> filteredProducts = new();
    private List<CategoryDto> categories = new();
    private List<BrandDto> brands = new();
    private bool isLoading = true;
    private const int pageSize = 10;

    // 2. Biến quản lý bộ lọc
    private string searchTerm = "";
    private int categoryFilter = 0;
    private string statusFilter = "all";

    // 3. Biến quản lý Modal (MỚI)
    private bool isModalVisible = false;
    private bool isLoadingModal = false;
    private ProductCreateUpdateDto editingProduct = new();

    //4.Toast
    private bool isToast = false;
    private string titleToast;
    private string classToast;
    private string messagesToast;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetaData();
        await LoadProducts();
    }

    private async Task LoadMetaData()
    {
        try { 
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories/all") ?? new(); 
            brands = await Http.GetFromJsonAsync<List<BrandDto>>("api/brands/header") ?? new();
        }
        catch { }
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        try
        {
            allProducts = await Http.GetFromJsonAsync<ProductPerPage>("api/products/mystore") ?? new();
            ApplyFilters();
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; }
    }

    private void ApplyFilters()
    {
        var query = allProducts.Items.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
            query = query.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

        if (categoryFilter > 0)
            query = query.Where(p => p.CategoryId == categoryFilter);

        if (statusFilter == "instock") query = query.Where(p => p.Quantity > 0);
        else if (statusFilter == "outofstock") query = query.Where(p => p.Quantity <= 0);

        filteredProducts = query.ToList();
    }

    private void HandleSearch() => ApplyFilters();
    private void OnCategoryFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            categoryFilter = id;
            ApplyFilters();
        }
    }

    private async Task OpenModal(int id)
    {
        isModalVisible = true;
        isLoadingModal = true;

        if (id == 0)
        {
            editingProduct = new ProductCreateUpdateDto { Images = new List<string>() };
        }
        else
        {
            try
            {
                var response = await Http.GetFromJsonAsync<ProductDto>($"api/products/{id}") ?? new ProductDto();

                editingProduct = new ProductCreateUpdateDto
                {
                   Id = response.Id,
                   Name = response.Name,
                   Description = response.Description,
                    Quantity = response.Quantity,
                    Price = response.Price,
                    Images = response.Images,
                    BrandId = response.BrandId,
                    CategoryId = response.CategoryId,
                    CreatedAt = response.CreatedAt,
                };

                if (editingProduct.Images == null) editingProduct.Images = new List<string>();
            }
            catch
            {
                ShowToast("Cảnh báo", "Lỗi tải dữ liệu sản phẩm", "warning");
                CloseModal();
            }
        }

        isLoadingModal = false;
    }


    private void CloseModal()
    {
        isModalVisible = false;
    }

    private async Task ChangePage(int newPageIndex)
    {
        if (newPageIndex > 0 && newPageIndex <= allProducts.TotalPages)
        {
            var queryString = $"api/products/mystore?pageIndex={newPageIndex}&pageSize={pageSize}";
            var response = await Http.GetAsync(queryString);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ProductPerPage>();
                if (result != null)
                {
                    allProducts = result;
                    filteredProducts = allProducts.Items;
                }
            }
        }
    }

    private async Task SaveProduct(ProductCreateUpdateDto dto)
    {
        HttpResponseMessage response;
        if (dto.Id == 0)
        {
            response = await Http.PostAsJsonAsync("api/products", dto);
        }
        else
        {
            response = await Http.PutAsJsonAsync($"api/products/{dto.Id}", dto);
        }

        if (response.IsSuccessStatusCode)
        {
            ShowToast("Thành công",
                      dto.Id == 0 ? "Thêm sản phẩm thành công" : "Cập nhật sản phẩm thành công",
                      "success");

            CloseModal();
            await LoadProducts();
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            ShowToast("Lỗi", $"Có lỗi xảy ra: {err}", "danger");
        }
    }

    private async Task ConfirmDelete(ProductDto product)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Xóa sản phẩm '{product.Name}'?");
        if (confirmed)
        {
            var response = await Http.DeleteAsync($"api/products/{product.Id}");
            if (response.IsSuccessStatusCode)
            {
                allProducts.Items.Remove(product);
                ApplyFilters();

                ShowToast("Thành công", "Xóa sản phẩm thành công", "success");
            }
            else
            {
                ShowToast("Lỗi", "Xóa sản phẩm thất bại", "danger");
            }
        }
    }

    private void ShowToast(string title, string message, string type = "success")
    {
        titleToast = title;
        messagesToast = message;
        classToast = type; // success | danger | warning
        isToast = true;
    }


    private void CloseToast()
    {
        isToast = false;
    }
}