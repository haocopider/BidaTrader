@page "/store/dashboard"

<PageTitle>Tổng quan Cửa hàng</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">

    @if (isLoading)
    {
        @* Hiệu ứng Loading khi đang gọi API *@
        <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (mystore != null)
    {
        @* HEADER: THÔNG TIN SHOP *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="card text-white mb-3 shadow-sm" style="background: linear-gradient(45deg, #696cff, #888bff);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-xl me-3 bg-white p-1 rounded-circle">
                                <img src="@(string.IsNullOrEmpty(mystore.AvatarUrl) ? "/images/default-avatar.png" : mystore.AvatarUrl)" alt="Logo" class="rounded-circle w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <h4 class="text-white fw-bold mb-1">Xin chào, @mystore.StoreName 👋</h4>
                                <p class="mb-0 opacity-75">
                                    <i class="bx bx-map me-1"></i> @mystore.Address |
                                    <i class="bx bx-calendar me-1"></i> Tham gia từ: @mystore.JoinDate.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                            <div class="ms-auto d-none d-md-block">
                                <button class="btn btn-outline-danger bg-danger text-white fw-bold shadow-sm">
                                    <i class="bx bx-show me-1"></i> Xem Shop
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* THỐNG KÊ 4 Ô *@
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-success"><i class="bx bx-wallet"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Doanh thu tháng</span>
                        <h4 class="card-title mb-2 text-success">@stats.MonthlyRevenue.ToString("N0") đ</h4>
                        <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +28.4%</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-cart"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Đơn hàng mới</span>
                        <h4 class="card-title mb-2">@stats.NewOrders</h4>
                        <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +12%</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-package"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Tổng sản phẩm</span>
                        <h4 class="card-title mb-2">@stats.TotalProducts</h4>
                        <small class="text-muted">Đang bán</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-info"><i class="bx bx-user-voice"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1">Người theo dõi</span>
                        <h4 class="card-title mb-2">@stats.Followers</h4>
                        <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +5 mới</small>
                    </div>
                </div>
            </div>
        </div>

        @* MAIN CONTENT *@
        <div class="row">
            <div class="col-lg-9 mb-4">
                @* KHU VỰC DYNAMIC CONTENT (Quản lý đơn/SP hoặc Biểu đồ) *@
                <div class="card mb-4 shadow-sm ">
                    @if (!isOrderHidden)
                    {
                        <ManageOrder Model="orders" ></ManageOrder>
                    }
                    else if (!isProductHidden && products != null)
                    {
                        <ManageProduct Model="products"></ManageProduct>
                    }
                    else
                    {
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h5 class="card-title m-0 me-2">Tổng quan doanh thu</h5>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button">2024</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-center align-items-center bg-light rounded" style="height: 300px;">
                                <div class="text-center text-muted">
                                    <i class="bx bx-bar-chart-alt-2 display-1"></i>
                                    <p class="mt-2">Biểu đồ thống kê sẽ hiển thị tại đây</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* BẢNG ĐƠN HÀNG CHỜ XỬ LÝ *@
                <div class="card shadow-sm">
                    <h5 class="card-header fw-bold">Đơn hàng chờ xử lý</h5>
                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã ĐH</th>
                                    <th>Khách hàng</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody class="table-border-bottom-0">
                                @if (recentOrders != null && recentOrders.Any())
                                {
                                    @foreach (var order in recentOrders)
                                    {
                                        <tr>
                                            <td><strong class="text-primary">#@order.Id</strong></td>
                                            <td>@order.CustomerName</td>
                                            <td class="fw-bold">@order.Total.ToString("N0") ₫</td>
                                            <td><span class="badge bg-label-warning me-1">@order.Status</span></td>
                                            <td>
                                                <a href="/store/orders/@order.Id" class="btn btn-sm btn-icon btn-outline-secondary">
                                                    <i class="bx bx-show"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">Không có đơn hàng nào đang chờ xử lý.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* SIDEBAR QUẢN LÝ NHANH *@
            <div class="col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="card-title m-0 me-2"><i class="bx bx-grid-alt me-2 text-primary"></i>Quản lý nhanh</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <a @onclick="() => ShowDashboard('p')" class="d-flex flex-column align-items-center justify-content-center border rounded p-4 text-decoration-none bg-label-hover-primary transition-all cursor-pointer" style="height: 140px;">
                                    <i class="bx bx-package fs-1 mb-2 text-primary"></i>
                                    <span class="fw-bold text-dark">Sản phẩm</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a @onclick="() => ShowDashboard('o')" class="d-flex flex-column align-items-center justify-content-center border rounded p-4 text-decoration-none bg-label-hover-success transition-all cursor-pointer" style="height: 140px;">
                                    <i class="bx bx-cart fs-1 mb-2 text-success"></i>
                                    <span class="fw-bold text-dark">Đơn hàng</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/store/posts" class="d-flex flex-column align-items-center justify-content-center border rounded p-4 text-decoration-none bg-label-hover-info transition-all" style="height: 140px;">
                                    <i class="bx bx-news fs-1 mb-2 text-info"></i>
                                    <span class="fw-bold text-dark">Bài viết</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/store/settings" class="d-flex flex-column align-items-center justify-content-center border rounded p-4 text-decoration-none bg-label-hover-warning transition-all" style="height: 140px;">
                                    <i class="bx bx-cog fs-1 mb-2 text-warning"></i>
                                    <span class="fw-bold text-dark">Cài đặt</span>
                                </a>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Thông báo hệ thống</h6>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                    <span><i class="bx bx-bell me-2 text-warning"></i> Bạn có 3 đánh giá mới</span>
                                    <small class="text-muted">2p trước</small>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0 mt-2">
                                    <span><i class="bx bx-check-circle me-2 text-success"></i> Đơn hàng #998 hoàn tất</span>
                                    <small class="text-muted">1h trước</small>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .bg-label-hover-primary:hover { background-color: #e7e7ff !important; border-color: #696cff !important; }
    .bg-label-hover-success:hover { background-color: #e8fadf !important; border-color: #71dd37 !important; }
    .bg-label-hover-info:hover { background-color: #d7f5fc !important; border-color: #03c3ec !important; }
    .bg-label-hover-warning:hover { background-color: #fff2d6 !important; border-color: #ffab00 !important; }
    .transition-all { transition: all 0.3s ease; }
</style>

@code {
    private bool isLoading = true;
    private bool isProductHidden = true;
    private bool isOrderHidden = true;

    private StoreDetailDto mystore;
    private DashboardStatsDto stats = new();
    private List<OrderSummaryDto> recentOrders = new();
    private ProductPerPage products;
    private List<StoreOrderDto> orders;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var taskStore = Http.GetFromJsonAsync<StoreDetailDto>("api/stores/mystore");

            if(taskStore != null)
                mystore = await taskStore;
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowDashboard(char obj)
    {
        if (obj == 'o')
        {
            isOrderHidden = false;
            isProductHidden = true;
            if(orders == null)
            {
                try
                {
                    orders = await Http.GetFromJsonAsync<List<StoreOrderDto>>("api/orders/store-orders");
                }
                catch(Exception ex)
                {
                    Console.WriteLine("Lỗi tải đơn hàng: " + ex.Message);
                }
        }
        }
        else if (obj == 'p')
        {
            if (products == null)
            {
                try 
                {
                    products = await Http.GetFromJsonAsync<ProductPerPage>("api/products/mystore");
                }
                catch(Exception ex)
                {
                    Console.WriteLine("Lỗi tải sản phẩm: " + ex.Message);
                }
            }
            
            isProductHidden = false;
            isOrderHidden = true;
        }
    }


    public class DashboardStatsDto
    {
        public decimal MonthlyRevenue { get; set; }
        public int NewOrders { get; set; }
        public int TotalProducts { get; set; }
        public int Followers { get; set; }
    }

    public class OrderSummaryDto
    {
        public string Id { get; set; }
        public string CustomerName { get; set; }
        public decimal Total { get; set; }
        public string Status { get; set; }
    }
    
}