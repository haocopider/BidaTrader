@page "/store/dashboard"

<PageTitle>Tổng quan Cửa hàng</PageTitle>

<div class="container-xxl flex-grow-1 container-p-y">

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (summary != null)
    {
        @* HEADER: THÔNG TIN SHOP *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="card text-white mb-3 shadow-sm border-0" style="background: linear-gradient(135deg, #696cff 0%, #888bff 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-xl me-3 bg-white p-1 rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                                <img src="@(string.IsNullOrEmpty(summary.AvatarUrl) ? "/assets/img/shop-placeholder.png" : summary.AvatarUrl)"
                                     alt="Logo" class="rounded-circle w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <h4 class="text-white fw-bold mb-1">@summary.StoreName 👋</h4>
                                <p class="mb-0 opacity-75 small">
                                    <i class="bx bx-map me-1"></i> @summary.Address <span class="mx-2">|</span>
                                    <i class="bx bx-calendar me-1"></i> Tham gia: @summary.JoinDate.ToString("dd/MM/yyyy")
                                </p>
                            </div>
                            <div class="ms-auto d-none d-md-block">
                                <a href="/store/@summary.StoreId" target="_blank" class="btn btn-light text-primary fw-bold shadow-sm">
                                    <i class="bx bx-store me-1"></i> Xem Shop Online
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* THỐNG KÊ 4 Ô *@
        <div class="row g-4 mb-4">
            @* Ô 1: Doanh thu tháng *@
            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-success"><i class="bx bx-wallet"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1 text-muted">Doanh thu tháng này</span>
                        <h4 class="card-title mb-2 text-success">@summary.CurrentMonthRevenue.ToString("N0") <small>đ</small></h4>

                        @if (summary.RevenueGrowth >= 0)
                        {
                            <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +@summary.RevenueGrowth.ToString("N1")%</small>
                        }
                        else
                        {
                            <small class="text-danger fw-semibold"><i class='bx bx-down-arrow-alt'></i> @summary.RevenueGrowth.ToString("N1")%</small>
                        }
                    </div>
                </div>
            </div>

            @* Ô 2: Đơn hàng *@
            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-cart"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1 text-muted">Đơn hàng mới</span>
                        <h4 class="card-title mb-2">@summary.CurrentMonthOrders</h4>
                        @if (summary.OrderGrowth >= 0)
                        {
                            <small class="text-success fw-semibold"><i class='bx bx-up-arrow-alt'></i> +@summary.OrderGrowth.ToString("N1")%</small>
                        }
                        else
                        {
                            <small class="text-danger fw-semibold"><i class='bx bx-down-arrow-alt'></i> @summary.OrderGrowth.ToString("N1")%</small>
                        }
                    </div>
                </div>
            </div>

            @* Ô 3: Sản phẩm bán ra *@
            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-warning"><i class="bx bx-package"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1 text-muted">SP đã bán tháng này</span>
                        <h4 class="card-title mb-2">@summary.TotalProductsSold</h4>
                        <small class="text-muted">Đang kinh doanh: <strong>@summary.TotalActiveProducts</strong> SP</small>
                    </div>
                </div>
            </div>

            @* Ô 4: Người theo dõi *@
            <div class="col-lg-3 col-md-6 col-6">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="card-title d-flex align-items-start justify-content-between">
                            <div class="avatar flex-shrink-0">
                                <span class="avatar-initial rounded bg-label-info"><i class="bx bx-user-voice"></i></span>
                            </div>
                        </div>
                        <span class="fw-semibold d-block mb-1 text-muted">Người theo dõi</span>
                        <h4 class="card-title mb-2">@summary.TotalFollowers</h4>
                        <small class="text-muted">Tổng quan</small>
                    </div>
                </div>
            </div>
        </div>

        @* MAIN CONTENT *@
        <div class="row">
            @* --- KHU VỰC TRUNG TÂM (Biểu đồ hoặc List) --- *@
            <div class="col-lg-9 mb-4">
                <div class="card mb-4 shadow-sm border-0 h-100">

                    @* 1. Tab Biểu đồ *@
                    @if (activeTab == "chart")
                    {
                        <div class="card-header d-flex align-items-center justify-content-between border-bottom">
                            <h5 class="card-title m-0 fw-bold text-primary">Biểu đồ doanh thu năm @DateTime.Now.Year</h5>
                        </div>
                        <div class="card-body p-4">
                            @if (summary.RevenueChartData != null && summary.RevenueChartData.Any())
                            {
                                <ApexChart TItem="MonthlyRevenueStatDto"
                                           Title=""
                                           Options="chartOptions">
                                    <ApexPointSeries TItem="MonthlyRevenueStatDto"
                                                     Items="summary.RevenueChartData"
                                                     Name="Doanh thu"
                                                     SeriesType="SeriesType.Area"
                                                     XValue="@(e => e.MonthLabel)"
                                                     YValue="@(e => e.Revenue)" />
                                </ApexChart>
                            }
                        </div>
                    }

                    @* 2. Tab Đơn hàng *@
                    else if (activeTab == "orders")
                    {
                        <div class="card-header d-flex align-items-center justify-content-between border-bottom">
                            <h5 class="card-title m-0 fw-bold">Quản lý Đơn hàng</h5>
                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => activeTab = "chart"'>Quay lại</button>
                        </div>
                        @if (orders != null)
                        {
                            <ManageOrder Model="orders"></ManageOrder>
                        }
                        else
                        {
                            <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div>
                        }
                    }

                    @* 3. Tab Sản phẩm *@
                    else if (activeTab == "products")
                    {
                        <div class="card-header d-flex align-items-center justify-content-between border-bottom">
                            <h5 class="card-title m-0 fw-bold">Quản lý Sản phẩm</h5>
                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => activeTab = "chart"'>Quay lại</button>
                        </div>
                        @if (products != null)
                        {
                            <ManageProduct Model="products"></ManageProduct>
                        }
                        else
                        {
                            <div class="p-5 text-center"><div class="spinner-border text-primary"></div></div>
                        }
                    }
                </div>
            </div>

            @* --- SIDEBAR QUẢN LÝ NHANH --- *@
            <div class="col-lg-3 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="card-title m-0 me-2 fw-bold"><i class="bx bx-grid-alt me-2 text-primary"></i>Truy cập nhanh</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <a @onclick='() => LoadTab("products")' class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none bg-label-hover-primary transition-all cursor-pointer h-100">
                                    <i class="bx bx-package fs-1 mb-2 text-primary"></i>
                                    <span class="fw-bold text-dark small">Sản phẩm</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a @onclick='() => LoadTab("orders")' class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none bg-label-hover-success transition-all cursor-pointer h-100">
                                    <i class="bx bx-cart fs-1 mb-2 text-success"></i>
                                    <span class="fw-bold text-dark small">Đơn hàng</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/store/posts" class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none bg-label-hover-info transition-all h-100">
                                    <i class="bx bx-news fs-1 mb-2 text-info"></i>
                                    <span class="fw-bold text-dark small">Bài viết</span>
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="/store/settings" class="d-flex flex-column align-items-center justify-content-center border rounded p-3 text-decoration-none bg-label-hover-warning transition-all h-100">
                                    <i class="bx bx-cog fs-1 mb-2 text-warning"></i>
                                    <span class="fw-bold text-dark small">Cài đặt</span>
                                </a>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Thông báo mới</h6>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                    <span><i class="bx bx-bell me-2 text-warning"></i> 3 đơn hàng mới</span>
                                    <small class="text-muted">Nay</small>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .bg-label-hover-primary:hover {
        background-color: #e7e7ff !important;
        border-color: #696cff !important;
    }

    .bg-label-hover-success:hover {
        background-color: #e8fadf !important;
        border-color: #71dd37 !important;
    }

    .bg-label-hover-info:hover {
        background-color: #d7f5fc !important;
        border-color: #03c3ec !important;
    }

    .bg-label-hover-warning:hover {
        background-color: #fff2d6 !important;
        border-color: #ffab00 !important;
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>

@code {
    private bool isLoading = true;
    private StoreDashboardSummaryDto summary;
    private string activeTab = "chart"; // "chart", "orders", "products"

    // Dữ liệu cho các tab con
    private ProductPerPage products;
    private List<StoreOrderDto> orders;

    // Cấu hình biểu đồ
    private ApexChartOptions<MonthlyRevenueStatDto> chartOptions = new ApexChartOptions<MonthlyRevenueStatDto>
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false }, Height = 350 },
        Colors = new List<string> { "#696cff" },
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
        DataLabels = new DataLabels { Enabled = false },
        Yaxis = new List<YAxis> {
            new YAxis {
                Labels = new YAxisLabels {
                    Formatter = @"function (value) { return new Intl.NumberFormat('vi-VN').format(value); }"
                }
            }
        },
        Tooltip = new Tooltip
        {
            Y = new TooltipY
            {
                Formatter = @"function(value) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value); }"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            summary = await Http.GetFromJsonAsync<StoreDashboardSummaryDto>("api/stores/dashboard-summary");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Lazy Loading cho các tab con
    private async Task LoadTab(string tabName)
    {
        activeTab = tabName;
        if (tabName == "orders" && orders == null)
        {
            try { orders = await Http.GetFromJsonAsync<List<StoreOrderDto>>("api/orders/store-orders"); } catch { }
        }
        else if (tabName == "products" && products == null)
        {
            try { products = await Http.GetFromJsonAsync<ProductPerPage>("api/products/mystore"); } catch { }
        }
    }
}