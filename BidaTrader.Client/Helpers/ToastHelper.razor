<div class="toast-top-center">
    <div class="bs-toast toast fade show bg-@ToastClass slide-down"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">
        <div class="toast-header">
            <i class="bx bx-bell me-2"></i>
            <div class="me-auto fw-semibold">@Title</div>
            @time.ToString("hh:mm")
            <button @onclick="OnCLose" type="button" class="btn-close" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @Messages
        </div>
    </div>
</div>


@code {
    [Parameter] public string ToastClass { get; set; } = "primary";
    [Parameter] public string Title { get; set; } = "Thông báo";
    [Parameter] public string Messages { get; set; } = "Lorem";
    [Parameter] public EventCallback OnCLose { get; set; }

    private DateTime time = DateTime.Now;
    private bool _autoCloseStarted = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_autoCloseStarted)
        {
            _autoCloseStarted = true;
            await Task.Delay(5000);

            if (OnCLose.HasDelegate)
            {
                await OnCLose.InvokeAsync();
            }
        }
    }
}
